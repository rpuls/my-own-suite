{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MOS app update comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "installed", "candidate", "compatibility", "changes", "requiredInput", "metadata", "validation", "confirmationToken"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "type": "string" },
    "installed": { "type": "object", "required": ["packageVersion", "packageDigest"], "properties": { "packageVersion": { "type": "string" }, "packageDigest": { "type": "string" } } },
    "candidate": { "type": "object", "required": ["packageVersion", "packageDigest", "source"], "properties": { "packageVersion": { "type": "string" }, "packageDigest": { "type": "string" }, "source": { "$ref": "app-package-source.schema.json" } } },
    "compatibility": { "enum": ["compatible", "owner-action-required", "unsupported", "unresolved"] },
    "changes": { "type": "array", "items": { "type": "object", "required": ["area", "classification", "summary"], "properties": { "area": { "type": "string" }, "classification": { "enum": ["automatically-handled", "migration-required", "operator-action-required", "unsupported", "unresolved"] }, "summary": { "type": "string" } } } },
    "requiredInput": { "type": "array", "items": { "type": "object", "required": ["id", "label", "secret", "type"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "secret": { "type": "boolean" }, "type": { "type": "string" } } } },
    "metadata": { "type": "object", "required": ["backupRequired", "downtime", "migrations", "ownerActions", "rollback"], "properties": { "backupRequired": { "type": "boolean" }, "downtime": { "enum": ["brief", "extended", "none", "unknown"] }, "migrations": { "type": "array", "items": { "type": "string" } }, "ownerActions": { "type": "array", "items": { "type": "string" } }, "rollback": { "enum": ["not-guaranteed", "safe", "unsupported"] } } },
    "validation": { "type": "object", "required": ["agentCapability", "errors"], "properties": { "agentCapability": { "enum": ["compatible", "unsupported"] }, "errors": { "type": "array", "items": { "type": "string" } } } },
    "confirmationToken": { "type": "string", "minLength": 1 }
  }
}
