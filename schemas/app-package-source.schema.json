{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MOS app package source identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "repository", "path", "revision", "trust"],
  "properties": {
    "kind": { "enum": ["official-git", "external-git", "local"] },
    "repository": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
    "revision": { "type": "string", "minLength": 1 },
    "trust": { "enum": ["mos-reviewed", "publisher-signed", "unverified"] }
  }
}
