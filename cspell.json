{
  "version": "0.2",
  "language": "en-GB",
  "dictionaries": [
    "en-gb",
    "softwareTerms",
    "node",
    "typescript",
    "bash",
    "docker",
    "html",
    "css"
  ],
  "ignorePaths": [
    "node_modules",
    "dist",
    "site/dist",
    "site-mos1-reference",
    "package-lock.json",
    "**/*.sig",
    "**/*.png",
    ".state",
    ".tmp",
    "test-results",
    "CHANGELOG.md"
  ],
  "ignoreRegExpList": [
    "Urls",
    "Email",
    "/`[^`]+`/g",
    "/\\b[0-9a-fA-F]{32,}\\b/g",
    "/sha256:[0-9a-fA-F]+/g",
    "/(?:class|className|id|href|src|d)=\"[^\"]*\"/g",
    "/className=\\{`[^`]*`\\}/g",
    "/className=\\{['\"][^'\"]+['\"]\\}/g",
    "/from\\s+['\"][^'\"]+['\"]/g",
    "/import\\s+['\"][^'\"]+['\"]/g",
    "/videoId=\"[^\"]+\"/g",
    "/\\bAKIA\\b/g",
    "/\\b[a-z]+(?:[A-Z][a-z0-9]*)+\\b/g"
  ],
  "overrides": [
    {
      "filename": "**/*.astro",
      "languageId": "html"
    },
    {
      "filename": "**/*.mdx",
      "languageId": "markdown"
    }
  ],
  "languageSettings": [
    {
      "languageId": "typescript,typescriptreact,javascript,javascriptreact",
      "includeRegExpList": [
        "CStyleComment",
        "string"
      ]
    }
  ],
