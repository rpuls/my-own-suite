# Copy this file to selfhost-installer.env and fill in your real values.
# The generated installer ISO uses these values for the Linux login on the
# fresh machine. Your Suite Manager owner account is NOT configured here —
# it is created in the browser after the first boot.

LINUX_PASSWORD=change-me-before-build
STACK_DOMAIN=mos.home

# Optional overrides:
# HOSTNAME=mos
# USERNAME=mos
# REALNAME=My Own Suite
# TIMEZONE=Europe/Copenhagen
