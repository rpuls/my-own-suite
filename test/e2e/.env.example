MOS_E2E_BASE_URL=http://home.mos.home
MOS_E2E_OWNER_NAME=MOS Owner
MOS_E2E_OWNER_EMAIL=owner@example.com
MOS_E2E_OWNER_PASSWORD=change-me-before-running

# Optional per-app setup overrides. Generated fields are filled by MOS.
MOS_E2E_RADICALE_USERNAME=admin
MOS_E2E_RADICALE_PASSWORD=change-me-before-running
MOS_E2E_SEAFILE_ADMIN_EMAIL=owner@example.com
MOS_E2E_SEAFILE_ADMIN_PASSWORD=change-me-before-running
MOS_E2E_VAULTWARDEN_NAME=MOS Owner
MOS_E2E_VAULTWARDEN_EMAIL=owner@example.com
MOS_E2E_VAULTWARDEN_PASSWORD=MOS-E2E-Master-Password-2026!

# Real DNS-01 validation for the full Hyper-V regression. Keep the real token only in .env.
# When base domain and token are both present, DNS-01 is enabled even if this legacy flag is 0.
MOS_E2E_ENABLE_DNS01=0
MOS_E2E_DNS01_BASE_DOMAIN=mos.example.com
MOS_E2E_DNS01_ACME_EMAIL=owner@example.com
CLOUDFLARE_API_TOKEN=

# Optional slower or state-mutating checks.
MOS_E2E_RESET_BEFORE_RUN=1
MOS_E2E_ENABLE_BACKUP=1
MOS_E2E_ENABLE_LIFECYCLE=0
MOS_E2E_ENABLE_RESTORE=1
MOS_E2E_ENABLE_UPDATE=0

# Comma-separated package ids. The first pre-DNS app is installed before backup,
# the remaining pre-DNS apps before DNS-01, and the second group after DNS-01.
MOS_E2E_PRE_DNS_APP_IDS=stirling-pdf,radicale
MOS_E2E_POST_DNS_APP_IDS=vaultwarden,seafile,onlyoffice
MOS_E2E_APP_IDS=stirling-pdf,vaultwarden,radicale,seafile,onlyoffice
