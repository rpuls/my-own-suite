MOS_E2E_BASE_URL=http://home.mos.hyperv
MOS_E2E_OWNER_NAME=MOS Owner
MOS_E2E_OWNER_EMAIL=owner@example.com
MOS_E2E_OWNER_PASSWORD=change-me-before-running

# Optional, for a Hyper-V lab: the VM's name, so a run follows the lab to the address the switch
# may lease it after a restart (the `reboot` and `power-cut` steps).
# MOS_E2E_LAB_VM=mos-usb-smoke

# Optional. Chromium host-resolver rules for the test browser, for a Hyper-V lab whose address
# moved when the hosts file cannot be rewritten without an elevated shell.
# MOS_E2E_HOST_RESOLVER_RULES=MAP *.hyperv.lab.example.site 172.25.191.202

# The domain the `dns01` step moves the suite to. Keep the real token out of files:
# set it in the environment, or let MOS_E2E_SECRETS_COMMAND print it.
MOS_E2E_DNS01_BASE_DOMAIN=mos.example.com
MOS_E2E_DNS01_ACME_EMAIL=owner@example.com
CLOUDFLARE_API_TOKEN=

# Optional. Each app module has its own defaults; override them here, for example:
# MOS_E2E_RADICALE_PASSWORD=change-me-before-running
# MOS_E2E_SEAFILE_ADMIN_PASSWORD=change-me-before-running
# MOS_E2E_VAULTWARDEN_PASSWORD=MOS-E2E-Master-Password-2026!
# The variables an app reads are at the top of its apps/<id>/e2e/index.mjs.

# Optional. A command that prints KEY=value lines, such as lab keys from a secrets manager; its
# output joins the environment, below anything set here. backup:bucket and restore:bucket need the
# disposable lab bucket's MOS_LAB_S3_* values from one or the other.
# MOS_E2E_SECRETS_COMMAND=
