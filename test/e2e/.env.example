MOS_E2E_BASE_URL=http://home.mos.hyperv
MOS_E2E_OWNER_NAME=MOS Owner
MOS_E2E_OWNER_EMAIL=owner@example.com
MOS_E2E_OWNER_PASSWORD=change-me-before-running

# The domain the `dns01` step moves the suite to. Keep the real token only in .env.
MOS_E2E_DNS01_BASE_DOMAIN=mos.example.com
MOS_E2E_DNS01_ACME_EMAIL=owner@example.com
CLOUDFLARE_API_TOKEN=

# Optional. Each app module has its own defaults; override them here, for example:
# MOS_E2E_RADICALE_PASSWORD=change-me-before-running
# MOS_E2E_SEAFILE_ADMIN_PASSWORD=change-me-before-running
# MOS_E2E_VAULTWARDEN_PASSWORD=MOS-E2E-Master-Password-2026!
# The variables an app reads are at the top of its apps/<id>/e2e/index.mjs.

# Optional. backup:bucket and restore:bucket read the disposable lab bucket from
# .local-tools/lab-bucket/bucket.env unless this names another file.
# MOS_E2E_BUCKET_ENV=
