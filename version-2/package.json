{
  "name": "my-own-suite-version-2",
  "version": "0.1.0",
  "private": true,
  "description": "Clean-slate MOS V2 launch platform workspace.",
  "type": "commonjs",
  "scripts": {
    "build:client": "npm run branding:sync && vite build --config suite-manager/vite.config.mjs",
    "branding:sync": "node scripts/sync-branding.cjs",
    "dev": "npm run build:client && node suite-manager/backend/src/server/start.cjs",
    "e2e:install": "playwright install chromium",
    "e2e:local": "playwright test --config tests/e2e/playwright.config.mjs",
    "e2e:local:headed": "playwright test --config tests/e2e/playwright.config.mjs --headed",
    "install:render": "node scripts/installers/render-bootstrap.cjs",
    "smoke:do:destroy": "node scripts/smoke/digitalocean-v2.cjs destroy",
    "smoke:do:dns01": "node scripts/smoke/dns01-v2.cjs",
    "smoke:do:render": "node scripts/smoke/digitalocean-v2.cjs render",
    "smoke:do:reset": "node scripts/smoke/digitalocean-v2.cjs reset",
    "smoke:hyperv:destroy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke/hyperv-usb-lab.ps1 destroy",
    "smoke:hyperv:reset": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke/hyperv-usb-lab.ps1 reset",
    "test": "npm run branding:sync && node --test suite-manager/backend/test/*.test.cjs system-agents/apps/*.test.cjs system-agents/https/*.test.cjs system-agents/homepage/*.test.cjs system-agents/update/*.test.cjs test/*.test.cjs",
    "typecheck": "tsc --project suite-manager/tsconfig.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "my-own-suite": "file:..",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": "22.x",
    "npm": "11.x"
  }
}
