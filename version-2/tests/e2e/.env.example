MOS_V2_E2E_BASE_URL=http://home.mos.home
MOS_V2_E2E_OWNER_NAME=MOS Owner
MOS_V2_E2E_OWNER_EMAIL=owner@example.com
MOS_V2_E2E_OWNER_PASSWORD=change-me-before-running

# Optional per-app setup overrides. Generated fields are filled by MOS.
MOS_V2_E2E_RADICALE_USERNAME=admin
MOS_V2_E2E_RADICALE_PASSWORD=change-me-before-running
MOS_V2_E2E_SEAFILE_ADMIN_EMAIL=owner@example.com
MOS_V2_E2E_SEAFILE_ADMIN_PASSWORD=change-me-before-running

# Optional real DNS-01 validation. Keep the real token only in .env.
MOS_V2_E2E_ENABLE_DNS01=0
MOS_V2_E2E_DNS01_BASE_DOMAIN=mos.example.com
MOS_V2_E2E_DNS01_ACME_EMAIL=owner@example.com
CLOUDFLARE_API_TOKEN=

# Optional slower or state-mutating checks.
MOS_V2_E2E_RESET_BEFORE_RUN=1
MOS_V2_E2E_ENABLE_BACKUP=1
MOS_V2_E2E_ENABLE_LIFECYCLE=0
MOS_V2_E2E_ENABLE_RESTORE=0
MOS_V2_E2E_ENABLE_UPDATE=0

# Comma-separated package ids. Leave empty for the current full catalog.
MOS_V2_E2E_APP_IDS=stirling-pdf,vaultwarden,radicale,seafile,onlyoffice
