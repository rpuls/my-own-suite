#!/usr/bin/env bash
# The bake VM already ran the control-plane bootstrap, so the only things left for
# the real machine are the ones about *this* machine: its own server login, and a
# banner carrying its own addresses.
#
# The bootstrap's own completion banner cannot be reused here. It runs at bake
# time, where the LAN IP belongs to the build VM and means nothing.
#
# It also renders over SSH, where any glyph works. This one renders on the Linux
# console, whose font is 256 glyphs, so it stays within Latin-1. The bootstrap
# banner's ✓ and ▸ are absent from it and would come out blank, and so is the
# block-drawing logo this banner used to open with — which was dropped for space
# rather than glyphs. A console can be 80x25 and the addresses matter more than
# the artwork, so the whole banner is budgeted to fit above the login prompt.
#
# There is no run-once guard on the unit: this re-renders on every boot, which is
# the recovery path when the machine's address changes.
set -euo pipefail

home_url='@@HOME_URL@@'
domain='@@DOMAIN@@'
docs_url='@@DOCS_URL@@'
begin='### My Own Suite address (begin)'
end='### My Own Suite address (end)'

if [ -x /usr/local/sbin/mos-console-login-init ]; then
  /usr/local/sbin/mos-console-login-init || true
fi

# Suite Manager's host gate admits the Easy Door name derived from
# `shared/easy-door.cjs`, so the banner has to name the address that module
# picks rather than the one `ip route` reports. They agree on an ordinary
# machine and need not on a multi-homed one, and a screen showing an address the
# box does not serve is worse than a screen showing none. The shell fallback
# runs only when the checkout is unreachable, and prints no Easy Door line at all.
easy_door_module=/opt/mos/repo/shared/easy-door.cjs
easy_door_available=no
if [ -x /usr/bin/node ] && [ -f "$easy_door_module" ]; then
  easy_door_available=yes
fi

detect_address() {
  if [ "$easy_door_available" = yes ]; then
    /usr/bin/node "$easy_door_module" address 2>/dev/null || true
  else
    ip -4 route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit } }'
  fi
}

lan_ip=''
for _ in $(seq 1 30); do
  lan_ip="$(detect_address)"
  [ -n "$lan_ip" ] && break
  sleep 2
done
[ -n "$lan_ip" ] || lan_ip="$(hostname -I 2>/dev/null | awk '{ print $1 }')"

# Empty on a public address, because the MOS nameserver refuses those names by
# design, and empty once a real domain has replaced the Caddyfile that serves
# this door.
easy_host=''
if [ "$easy_door_available" = yes ] && [ -n "$lan_ip" ]; then
  easy_host="$(/usr/bin/node "$easy_door_module" home-host "$lan_ip" 2>/dev/null || true)"
fi

install -d -m 0755 /etc/issue.d
banner=/etc/issue.d/10-mos-address.issue
{
  printf '   \033[1;32m»  My Own Suite is installed and running on this machine.\033[0m\n'
  printf '\n'
  if [ -n "$lan_ip" ]; then
    printf '   \033[1mFirst, reserve this address in your router:\033[0m  \033[1;36m%s\033[0m\n' "$lan_ip"
    printf '   \033[2mSelf-hosting needs an address that does not change.\033[0m\n'
    printf '\n'
    if [ -n "$easy_host" ]; then
      printf '   \033[1mIf your router or Pi-hole can point \033[0m\033[1;36m*.%s\033[0m\033[1m here:\033[0m\n' "$domain"
      printf '      \033[1;36m%-24s\033[0m \033[2mNothing ever leaves your network.\033[0m\n' "$home_url"
      printf '\n'
      printf '   \033[1mIf it cannot:\033[0m\n'
      printf '      \033[1;36mhttp://%s/\033[0m\n' "$easy_host"
      printf '      \033[2mNothing to set up, works on every device. Looking up your app\033[0m\n'
      printf '      \033[2mnames sends those lookups to My Own Suite.\033[0m\n'
      printf '\n'
      printf '   \033[33m»\033[0m  \033[1mOpen either address and create your owner account to finish setup.\033[0m\n'
      printf '      \033[2mBoth are plain HTTP; trusted HTTPS needs a domain of your own.\033[0m\n'
      printf '\n'
      printf '   \033[2mNo answer on the second address? Your router refuses names pointing\033[0m\n'
      printf '   \033[2minto your own network. Use the first.\033[0m\n'
    else
      printf '   \033[1mPoint \033[0m\033[1;36m*.%s\033[0m\033[1m at this machine in your router or Pi-hole, then open:\033[0m\n' "$domain"
      printf '      \033[1;36m%s\033[0m\n' "$home_url"
      printf '\n'
      printf '   \033[33m»\033[0m  \033[1mCreate your owner account there to finish setup.\033[0m\n'
      printf '      \033[2mIt is plain HTTP; trusted HTTPS needs a domain of your own.\033[0m\n'
    fi
  else
    # Printing an address line with nothing in it would be worse than saying
    # nothing: it reads as advice and cannot work.
    printf '   \033[1;33mThis machine has no network address yet.\033[0m\n'
    printf '\n'
    printf '   \033[2mMy Own Suite is installed and running, but nothing can reach it until\033[0m\n'
    printf '   \033[2mit is on your network. Plug it into your router, then reboot to see\033[0m\n'
    printf '   \033[2mthe address and the last setup step.\033[0m\n'
  fi
  printf '\n'
  printf '   \033[2mHelp\033[0m  \033[36m%s\033[0m\n' "$docs_url"
  printf '\n'
} > "$banner"
chmod 0644 "$banner"

# Only for machines built by an earlier image, which put this block straight into
# /etc/issue with visible markers. agetty prints /etc/issue.d/*.issue after
# /etc/issue, so the banner now lands closest to the login prompt with no markers.
if [ -f /etc/issue ] && grep -qF "$begin" /etc/issue; then
  awk -v b="$begin" -v e="$end" \
    'index($0, b) { skip = 1 } !skip { print } index($0, e) { skip = 0 }' /etc/issue > /etc/issue.next
  mv /etc/issue.next /etc/issue
  chmod 0644 /etc/issue
fi

# agetty renders /etc/issue when it paints a prompt and never redraws one it has
# already painted, so without this the machine sits on the pre-install banner
# until someone presses a key.
systemctl restart getty@tty1.service >/dev/null 2>&1 || true
exit 0
