#!/usr/bin/env bash
# The console banner: this machine's own addresses, and what state it is in.
#
# The bootstrap's own completion banner cannot be reused here. It runs at bake
# time, where the LAN IP belongs to the build VM and means nothing.
#
# Two constraints are invisible in the text below and both were learned the hard
# way on real hardware, so treat them as fixed:
#
# Latin-1, plus the exact block and double-line box drawing the logo is made of.
# Those glyphs are observed to render on real machines. The single-line ─ is not
# among them and is not interchangeable with ═: it came off a physical console as
# a row of `?` while the logo above it rendered perfectly, which is why the rules
# it drew are gone rather than redrawn. Add a glyph here only after seeing it on
# a screen - ✓ (U+2713) and ▸ (U+25B8) do not render either.
#
# The screen is as tall as the machine says it is, and no taller. A UEFI machine
# may hand the kernel a framebuffer console of 45 rows or more; plenty of
# firmware hands it an 80x25 text mode instead. Both exist on this desk. So there
# are two screens, written out separately below and laid out differently rather
# than one being the other with lines removed, and the machine is asked which one
# it has room for.
#
# There is no run-once guard on the unit: this re-renders on every boot, and
# mos-address-watch.timer runs it again every couple of minutes. An address that
# moves under a running machine leaves this screen the only surface still telling
# the truth - Suite Manager knows its address drifted and offers to follow, but
# an owner who cannot reach Suite Manager cannot be told that. Waiting for a
# reboot to say so is the difference between a minute and an evening for someone
# who does not know a reboot is what is called for. The same re-run is what picks
# up a console that only reaches its full size once a graphics driver has loaded.
#
# Being safe to run on a timer is the whole of what that costs: the banner is
# written and the console repainted only when what it would say has changed,
# because restarting agetty throws off whoever is signed in at the console.
#
# It reads nothing under a protected path, so it runs whether the vault opened
# or not - and says which.
set -euo pipefail

home_url='@@HOME_URL@@'
domain='@@DOMAIN@@'
docs_url='@@DOCS_URL@@'
easy_docs_url='@@EASY_DOCS_URL@@'

# Suite Manager's host gate admits the Easy Door name derived from
# `shared/easy-door.cjs`, so the banner has to name the address that module
# picks rather than the one `ip route` reports. They agree on an ordinary
# machine and need not on a multi-homed one, and a screen showing an address the
# box does not serve is worse than a screen showing none. The shell fallback
# runs only when the checkout is unreachable, and prints no Easy Door line at all.
easy_door_module=/opt/mos/repo/shared/easy-door.cjs
easy_door_available=no
if [ -x /usr/bin/node ] && [ -f "$easy_door_module" ]; then
  easy_door_available=yes
fi

detect_address() {
  if [ "$easy_door_available" = yes ]; then
    /usr/bin/node "$easy_door_module" address 2>/dev/null || true
  else
    ip -4 route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit } }'
  fi
}

lan_ip=''
for _ in $(seq 1 30); do
  lan_ip="$(detect_address)"
  [ -n "$lan_ip" ] && break
  sleep 2
done
[ -n "$lan_ip" ] || lan_ip="$(hostname -I 2>/dev/null | awk '{ print $1 }')"

# Empty on a public address, because the MOS nameserver refuses those names by
# design, and empty once a real domain has replaced the Caddyfile that serves
# this door. Every second-door line below sits behind it, so one machine sees
# two doors and another sees one, with no dead address on either.
easy_host=''
if [ "$easy_door_available" = yes ] && [ -n "$lan_ip" ]; then
  easy_host="$(/usr/bin/node "$easy_door_module" home-host "$lan_ip" 2>/dev/null || true)"
fi

# The certificate arrives minutes after boot, or never, so the scheme is whatever
# a trusted handshake on this machine proves now; the timer repaints when it lands.
easy_scheme=http
if [ -n "$easy_host" ] && curl -s -o /dev/null --max-time 5 --resolve "$easy_host:443:127.0.0.1" "https://$easy_host/" 2>/dev/null; then
  easy_scheme=https
fi

# The gate fails when there is a vault and it did not open. Everything that
# holds the owner's data is stopped until the key is entered on the page the
# addresses below serve, and the banner must say so rather than "running".
vault_locked=no
if systemctl is-failed --quiet mos-vault.service 2>/dev/null; then
  vault_locked=yes
fi

# ---------------------------------------------------------------------------
# The screens. Each one is written out in full, in the order it appears on the
# console - its own logo included - so that what a machine prints can be read
# and changed here without unpicking it from the others. They share nothing, and
# that is deliberate: the tall screen opens with the six-row logo and states the
# machine under it, while the short one uses a four-row logo with the state set
# beside it, which is five rows it can spend on words instead. Where a screen
# still asks a question, it is because the machine is in one state or another,
# not because the screen has two shapes.
# ---------------------------------------------------------------------------

# THE FULL SCREEN - 39 rows, printed when the console has room for it.
#
# It opens with the six-row logo, because a screen with rows to spare should
# look like something. Nothing below it is decoration: the reservation is the
# step people skip, the paragraph under A is the only place an owner is told why
# A is worth the trouble, the paragraph under B is the only place they are told
# that an address which looks public is not, and the note under that is what
# they read when B does not load. Adding a row here means raising `tall_rows`,
# and the unit test says so.
render_tall() {
  printf '\033[2J\033[H\033[32m      ███╗   ███╗  ██████╗  ███████╗\033[0m\n'
  printf '\033[32m      ████╗ ████║ ██╔═══██╗ ██╔════╝\033[0m\n'
  printf '\033[32m      ██╔████╔██║ ██║   ██║ ███████╗\033[0m\n'
  printf '\033[32m      ██║╚██╔╝██║ ██║   ██║ ╚════██║\033[0m\n'
  printf '\033[32m      ██║ ╚═╝ ██║ ╚██████╔╝ ███████║\033[0m\n'
  printf '\033[32m      ╚═╝     ╚═╝  ╚═════╝  ╚══════╝\033[0m\n'
  printf '\n'
  if [ "$vault_locked" = yes ]; then
    printf '  \033[1;33m>  Locked.\033[0m  \033[2mThis machine is\033[0m  \033[1;36m%s\033[0m\n' "$lan_ip"
    printf '\n'
    printf '     \033[2mYour data is encrypted and waiting for your recovery key. Open one\033[0m\n'
    printf '     \033[2mof the addresses below, enter it, and your apps start.\033[0m\n'
  else
    printf '  \033[1;32m>  Installed and running.\033[0m  \033[2mThis machine is\033[0m  \033[1;36m%s\033[0m\n' "$lan_ip"
    printf '\n'
    printf '     \033[2mReserve that address in your router before anything else - your\033[0m\n'
    printf '     \033[2mrouter may call it a DHCP reservation. This step is important.\033[0m\n'
  fi
  printf '\n'
  if [ -n "$easy_host" ]; then
    printf '  \033[1;32mA   THE BEST WAY IN\033[0m \033[2m- if you can add a DNS rule\033[0m\n'
  else
    printf '  \033[1;32mTHE WAY IN\033[0m \033[2m- add a DNS rule for this machine\033[0m\n'
  fi
  printf '\n'
  printf '      \033[2mYour router, Pi-hole or AdGuard Home needs one wildcard record:\033[0m\n'
  printf '\n'
  printf '          \033[1;36m*.%-15s ->        %s\033[0m\n' "$domain" "$lan_ip"
  printf '\n'
  printf '      \033[2mThen open\033[0m        \033[1;36m%s\033[0m\n' "$home_url"
  printf '\n'
  if [ -n "$easy_host" ]; then
    printf '      \033[2mIt keeps working without the internet or any server of ours. Take\033[0m\n'
    printf '      \033[2mthis one if you can - many routers cannot, and that is why B exists.\033[0m\n'
    printf '\n'
    printf '  \033[1;32mB   THE EASY WAY IN\033[0m \033[2m- nothing to set up\033[0m\n'
    printf '\n'
    printf '      \033[2mOpen\033[0m   \033[1;36m%s://%s/\033[0m\n' "$easy_scheme" "$easy_host"
    printf '\n'
    printf '      \033[2mAny device on your home network, phones included. The address\033[0m\n'
    printf '      \033[2mlooks public but it is not - nothing outside can reach your suite.\033[0m\n'
    printf '      \033[2mCurious how?\033[0m  \033[36m%s\033[0m\n' "$easy_docs_url"
    printf '\n'
    printf '      \033[2mNothing loads? Your router is refusing addresses that point into\033[0m\n'
    printf '      \033[2myour own network. Allow local.myownsuite.org in its DNS settings,\033[0m\n'
    printf '      \033[2mor use A instead.\033[0m\n'
  else
    printf '      \033[2mYour apps and your data stay on this machine.\033[0m\n'
  fi
  printf '\n'
  printf '  \033[33m>\033[0m  \033[1mOnce inside, follow the instructions on screen.\033[0m\n'
  if [ -n "$easy_host" ]; then
    printf '     \033[2mBoth addresses reach your suite only from inside your own network.\033[0m\n'
  else
    printf '     \033[2mThat address reaches your suite only from inside your own network.\033[0m\n'
  fi
  printf '\n'
  printf '  \033[2mNeed help?\033[0m  \033[36m%s\033[0m\n' "$docs_url"
}

# THE SHORT SCREEN - 20 rows, for an 80x25 console and for one that will not say
# how big it is.
#
# It is not the full screen with lines removed. It has its own four-row logo,
# and the machine's state is set beside it rather than under it: those five rows
# are what pays for keeping the reason to prefer A, the reassurance about B's
# address, and the note for when B does not load. The state block is written out
# twice, once running and once locked, because what a console prints should be
# readable here as the four rows it is.
render_short() {
  if [ "$vault_locked" = yes ]; then
    printf '\033[2J\033[H\033[32m  ██   ██  ██████  ██████\033[0m   \033[1;33mLocked.\033[0m\n'
    printf '\033[32m  ███ ███  ██  ██  ███   \033[0m   \033[2mThis machine is\033[0m  \033[1;36m%s\033[0m\n' "$lan_ip"
    printf '\033[32m  ██ █ ██  ██  ██     ███\033[0m   \033[2mYour data is encrypted. Open an address\033[0m\n'
    printf '\033[32m  ██   ██  ██████  ██████\033[0m   \033[2mbelow and enter your recovery key.\033[0m\n'
  else
    printf '\033[2J\033[H\033[32m  ██   ██  ██████  ██████\033[0m   \033[1;32mInstalled and running.\033[0m\n'
    printf '\033[32m  ███ ███  ██  ██  ███   \033[0m   \033[2mThis machine is\033[0m  \033[1;36m%s\033[0m\n' "$lan_ip"
    printf '\033[32m  ██ █ ██  ██  ██     ███\033[0m   \033[2mReserve that address in your router -\033[0m\n'
    printf '\033[32m  ██   ██  ██████  ██████\033[0m   \033[2mit may call it a DHCP reservation.\033[0m\n'
  fi
  printf '\n'
  if [ -n "$easy_host" ]; then
    printf '  \033[1;32mA   THE BEST WAY IN\033[0m \033[2m- one DNS rule in your router, Pi-hole or AdGuard Home\033[0m\n'
  else
    printf '  \033[1;32mTHE WAY IN\033[0m \033[2m- one DNS rule in your router, Pi-hole or AdGuard Home\033[0m\n'
  fi
  printf '      \033[1;36m*.%s  ->  %s\033[0m\n' "$domain" "$lan_ip"
  printf '      \033[2mThen open\033[0m  \033[1;36m%s\033[0m\n' "$home_url"
  if [ -n "$easy_host" ]; then
    printf '      \033[2mIt keeps working without the internet or any server of ours. Take\033[0m\n'
    printf '      \033[2mthis one if you can - many routers cannot, and that is why B exists.\033[0m\n'
    printf '\n'
    printf '  \033[1;32mB   THE EASY WAY IN\033[0m \033[2m- nothing to set up\033[0m\n'
    printf '      \033[2mOpen\033[0m  \033[1;36m%s://%s/\033[0m\n' "$easy_scheme" "$easy_host"
    printf '      \033[2mAny device on your home network, phones included. It looks public\033[0m\n'
    printf '      \033[2mbut it is not - nothing outside can reach your suite.\033[0m\n'
    printf '      \033[2mNothing loads? Allow local.myownsuite.org in your router DNS settings.\033[0m\n'
  else
    printf '      \033[2mYour apps and your data stay on this machine.\033[0m\n'
  fi
  printf '\n'
  printf '  \033[33m>\033[0m  \033[1mOnce inside, follow the instructions on screen.\033[0m\n'
  if [ -n "$easy_host" ]; then
    printf '     \033[2mBoth addresses reach your suite only from inside your own network.\033[0m\n'
  else
    printf '     \033[2mThat address reaches your suite only from inside your own network.\033[0m\n'
  fi
  printf '  \033[2mNeed help?\033[0m  \033[36m%s\033[0m\n' "$docs_url"
}

# NO ADDRESS - 10 rows, and the same on every console, because it fits the
# smallest one. Printing an address line with nothing in it would be worse than
# saying nothing: it reads as advice and cannot work.
render_no_address() {
  printf '\033[2J\033[H\033[32m  ██   ██  ██████  ██████\033[0m   \033[1;33mThis machine has no network\033[0m\n'
  printf '\033[32m  ███ ███  ██  ██  ███   \033[0m   \033[1;33maddress yet.\033[0m\n'
  printf '\033[32m  ██ █ ██  ██  ██     ███\033[0m\n'
  printf '\033[32m  ██   ██  ██████  ██████\033[0m\n'
  printf '\n'
  printf '  \033[2mMy Own Suite is installed, but nothing can reach it until it is on\033[0m\n'
  printf '  \033[2myour network. Plug it into your router, then reboot to see the\033[0m\n'
  printf '  \033[2maddress and the last setup step.\033[0m\n'
  printf '\n'
  printf '  \033[2mNeed help?\033[0m  \033[36m%s\033[0m\n' "$docs_url"
}

# ---------------------------------------------------------------------------
# Which screen this machine gets.
#
# The kernel keeps a window size per virtual console and updates it whenever the
# mode or the font changes, so tty1 is asked rather than the framebuffer: the
# pixel geometry under /sys says nothing about the font drawn on it, and this
# screen is measured in characters. A console that will not answer, or answers
# something implausible, counts as the smallest console there is - which is the
# mode this banner used to assume for every machine.
#
# `tall_rows` is what render_tall prints and `reserved_rows` is what is printed
# under it: the server login mos-console-login writes as its own file, and the
# row agetty spends on the prompt. Both are asserted by the unit test rather
# than trusted, because a screen one row too tall scrolls its own logo away.
# ---------------------------------------------------------------------------
tall_rows=39
reserved_rows=5
console_rows=25
console_cols=80
console_size="$(stty -F /dev/tty1 size 2>/dev/null || true)"
case "$console_size" in
  [0-9]*\ [0-9]*)
    rows="${console_size%% *}"
    cols="${console_size##* }"
    if [ "$rows" -ge 24 ] && [ "$cols" -ge 80 ]; then
      console_rows="$rows"
      console_cols="$cols"
    fi
    ;;
esac

layout=short
if [ "$console_rows" -ge "$((tall_rows + reserved_rows))" ]; then
  layout=tall
fi
# Journal only, and the one line a support bundle needs to explain which screen
# an owner is describing.
echo "[mos] console ${console_rows}x${console_cols}, ${layout} banner"

install -d -m 0755 /etc/issue.d
banner=/etc/issue.d/10-mos-address.issue
# Staged beside the real file so replacing it is an atomic rename on the same
# filesystem: agetty reads this directory every time it paints, and must never
# catch a half-written screen. The suffix keeps the staged copy out of the
# `*.issue` glob agetty expands while it is being written.
staged="${banner}.tmp"
{
  if [ -z "$lan_ip" ]; then
    render_no_address
  elif [ "$layout" = tall ]; then
    render_tall
  else
    render_short
  fi
} > "$staged"
chmod 0644 "$staged"

# The screen already says this. Leaving without touching it is what makes the
# timer harmless: a repaint every couple of minutes would throw off whoever is
# signed in at the console, forever, on every machine.
if cmp -s "$staged" "$banner"; then
  rm -f "$staged"
  exit 0
fi
mv "$staged" "$banner"

# agetty renders /etc/issue when it paints a prompt and never redraws one it has
# already painted, so without this the machine sits on the pre-install banner
# until someone presses a key.
systemctl restart getty@tty1.service >/dev/null 2>&1 || true
exit 0
