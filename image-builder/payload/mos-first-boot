#!/usr/bin/env bash
# The console banner: this machine's own addresses, and what state it is in.
#
# The bootstrap's own completion banner cannot be reused here. It runs at bake
# time, where the LAN IP belongs to the build VM and means nothing.
#
# It also renders over SSH, where any glyph works. This one renders on the Linux
# console, whose font is 256 glyphs: Latin-1 plus the VGA box and block drawing
# the logo and the rules are made of. The bootstrap banner's ✓ and ▸ are in
# neither set and would come out blank.
#
# There is no run-once guard on the unit: this re-renders on every boot, which is
# the recovery path when the machine's address changes. It reads nothing under a
# protected path, so it runs whether the vault opened or not - and says which.
# The server login is not this script's business: mos-console-login writes it as
# its own file after this banner, and only once the vault has opened.
set -euo pipefail

home_url='@@HOME_URL@@'
domain='@@DOMAIN@@'
docs_url='@@DOCS_URL@@'
easy_docs_url='@@EASY_DOCS_URL@@'

# Suite Manager's host gate admits the Easy Door name derived from
# `shared/easy-door.cjs`, so the banner has to name the address that module
# picks rather than the one `ip route` reports. They agree on an ordinary
# machine and need not on a multi-homed one, and a screen showing an address the
# box does not serve is worse than a screen showing none. The shell fallback
# runs only when the checkout is unreachable, and prints no Easy Door line at all.
easy_door_module=/opt/mos/repo/shared/easy-door.cjs
easy_door_available=no
if [ -x /usr/bin/node ] && [ -f "$easy_door_module" ]; then
  easy_door_available=yes
fi

detect_address() {
  if [ "$easy_door_available" = yes ]; then
    /usr/bin/node "$easy_door_module" address 2>/dev/null || true
  else
    ip -4 route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit } }'
  fi
}

lan_ip=''
for _ in $(seq 1 30); do
  lan_ip="$(detect_address)"
  [ -n "$lan_ip" ] && break
  sleep 2
done
[ -n "$lan_ip" ] || lan_ip="$(hostname -I 2>/dev/null | awk '{ print $1 }')"

# Empty on a public address, because the MOS nameserver refuses those names by
# design, and empty once a real domain has replaced the Caddyfile that serves
# this door. Every second-door line below sits behind it, so one machine sees
# two doors and another sees one, with no dead address on either.
easy_host=''
if [ "$easy_door_available" = yes ] && [ -n "$lan_ip" ]; then
  easy_host="$(/usr/bin/node "$easy_door_module" home-host "$lan_ip" 2>/dev/null || true)"
fi

# The vault gate works out which medium this boot runs from and leaves the
# answer here. A machine that reaches this screen from the installer stick has
# not been installed, and every line below would otherwise read as if it had.
running_from_removable=no
if [ -e /run/mos/installer-media ]; then
  running_from_removable=yes
fi

# The gate fails when there is a vault and it did not open. Everything that
# holds the owner's data is stopped until the key is entered on the page the
# addresses below serve, and the banner must say so rather than "running".
vault_locked=no
if systemctl is-failed --quiet mos-vault.service 2>/dev/null; then
  vault_locked=yes
fi

install -d -m 0755 /etc/issue.d
banner=/etc/issue.d/10-mos-address.issue
{
  # agetty renders /etc/issue before this file and hands whatever is in it
  # straight to the terminal, so clearing here puts the banner on a blank console
  # instead of underneath the boot log. Files after this one in /etc/issue.d,
  # the server login among them, are printed after it and stay on screen.
  printf '\033[2J\033[H\033[32m      ███╗   ███╗  ██████╗  ███████╗\033[0m\n'
  printf '\033[32m      ████╗ ████║ ██╔═══██╗ ██╔════╝\033[0m\n'
  printf '\033[32m      ██╔████╔██║ ██║   ██║ ███████╗\033[0m\n'
  printf '\033[32m      ██║╚██╔╝██║ ██║   ██║ ╚════██║\033[0m\n'
  printf '\033[32m      ██║ ╚═╝ ██║ ╚██████╔╝ ███████║\033[0m\n'
  printf '\033[32m      ╚═╝     ╚═╝  ╚═════╝  ╚══════╝\033[0m\n'
  printf '\n'
  if [ -n "$lan_ip" ]; then
    # The three headlines occupy the same rows deliberately: they are mutually
    # exclusive, so the banner does not get taller for carrying a warning.
    if [ "$running_from_removable" = yes ]; then
      printf '   \033[1;33m»  RUNNING FROM THE USB STICK\033[0m  \033[2mreachable at\033[0m  \033[1;36m%s\033[0m\n' "$lan_ip"
      printf '\n'
      printf '      \033[2mNothing is installed. This machine stops booting the moment the\033[0m\n'
      printf '      \033[2mstick is removed - reboot with it attached and choose 1 to install.\033[0m\n'
    else
      if [ "$vault_locked" = yes ]; then
        printf '   \033[1;33m»  Locked.\033[0m  \033[2mThis machine is\033[0m  \033[1;36m%s\033[0m\n' "$lan_ip"
        printf '\n'
        printf '      \033[2mYour data is encrypted and waiting for your recovery key. Open one\033[0m\n'
        printf '      \033[2mof the addresses below, enter it, and your apps start.\033[0m\n'
      else
        printf '   \033[1;32m»  Installed and running.\033[0m  \033[2mThis machine is\033[0m  \033[1;36m%s\033[0m\n' "$lan_ip"
        printf '\n'
        printf '      \033[2mReserve that address in your router before anything else - your\033[0m\n'
        printf '      \033[2mrouter may call it a DHCP reservation. This step is important.\033[0m\n'
      fi
    fi
    printf '\n'
    printf '   \033[2m────────────────────────────────────────────────────────────────\033[0m\n'
    printf '\n'
    if [ -n "$easy_host" ]; then
      printf '   \033[1;32mA   THE BEST WAY IN\033[0m \033[2m- if you can add a DNS rule\033[0m\n'
    else
      printf '   \033[1;32mTHE WAY IN\033[0m \033[2m- add a DNS rule for this machine\033[0m\n'
    fi
    printf '\n'
    printf '       \033[2mYour router, Pi-hole or AdGuard Home needs one wildcard record:\033[0m\n'
    printf '\n'
    printf '           \033[1;36m*.%-15s ->        %s\033[0m\n' "$domain" "$lan_ip"
    printf '\n'
    printf '       \033[2mThen open\033[0m        \033[1;36m%s\033[0m\n' "$home_url"
    printf '\n'
    if [ -n "$easy_host" ]; then
      printf '       \033[2mNothing about your suite ever leaves your network. Take this one\033[0m\n'
      printf '       \033[2mif you can - many routers cannot do it, and that is why B exists.\033[0m\n'
      printf '\n'
      printf '   \033[1;32mB   THE EASY WAY IN\033[0m \033[2m- nothing to set up\033[0m\n'
      printf '\n'
      printf '       \033[2mOpen\033[0m   \033[1;36mhttp://%s/\033[0m\n' "$easy_host"
      printf '\n'
      printf '       \033[2mAny device on your home network, phones included. The address\033[0m\n'
      printf '       \033[2mlooks public but it is not - nothing outside can reach your suite.\033[0m\n'
      printf '       \033[2mCurious how?\033[0m  \033[36m%s\033[0m\n' "$easy_docs_url"
      printf '\n'
      printf '       \033[2mNothing loads? Your router is refusing addresses that point into\033[0m\n'
      printf '       \033[2myour own network. Allow local.myownsuite.org in its DNS settings,\033[0m\n'
      printf '       \033[2mor use A instead.\033[0m\n'
    else
      printf '       \033[2mNothing about your suite ever leaves your network.\033[0m\n'
    fi
    printf '\n'
    printf '   \033[2m────────────────────────────────────────────────────────────────\033[0m\n'
    printf '\n'
    printf '   \033[33m»\033[0m  \033[1mOnce inside, follow the instructions on screen.\033[0m\n'
    if [ -n "$easy_host" ]; then
      printf '      \033[2mBoth addresses reach your suite only from inside your own network.\033[0m\n'
    else
      printf '      \033[2mThat address reaches your suite only from inside your own network.\033[0m\n'
    fi
  else
    # Printing an address line with nothing in it would be worse than saying
    # nothing: it reads as advice and cannot work.
    printf '   \033[1;33mThis machine has no network address yet.\033[0m\n'
    printf '\n'
    if [ "$running_from_removable" = yes ]; then
      printf '   \033[2mMy Own Suite is running from the USB stick and nothing is installed.\033[0m\n'
      printf '   \033[2mPlug it into your router, then reboot to see the address - and to\033[0m\n'
      printf '   \033[2mchoose 1 and install it onto the internal disk.\033[0m\n'
    else
      printf '   \033[2mMy Own Suite is installed, but nothing can reach it until it is on\033[0m\n'
      printf '   \033[2myour network. Plug it into your router, then reboot to see the\033[0m\n'
      printf '   \033[2maddress and the last setup step.\033[0m\n'
    fi
  fi
  printf '\n'
  printf '   \033[2mNeed Help?\033[0m   \033[36m%s\033[0m\n' "$docs_url"
  printf '\n'
} > "$banner"
chmod 0644 "$banner"

# agetty renders /etc/issue when it paints a prompt and never redraws one it has
# already painted, so without this the machine sits on the pre-install banner
# until someone presses a key.
systemctl restart getty@tty1.service >/dev/null 2>&1 || true
exit 0
