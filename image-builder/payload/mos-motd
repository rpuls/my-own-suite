#!/bin/sh
# Replaces Ubuntu's default `/etc/update-motd.d/` set, which the finalize step
# deletes. Three of those scripts are wrong on a MOS machine rather than merely
# unwanted: they advertise Ubuntu Pro on a product that sells no subscription,
# print an apt update count that contradicts Suite Manager's own Updates screen,
# and fetch news from motd.ubuntu.com on a timer — a scheduled outbound call
# nobody opted into, on a suite whose claim is that nothing leaves it.
#
# This runs on every login, so it does no work: no address lookup, no node, no
# network. The console banner in /etc/issue.d already carries this machine's
# addresses, and it is the screen that has a reason to know them.
. /etc/os-release 2>/dev/null || true

printf '\n'
printf '   \033[1;32mMy Own Suite\033[0m  \033[2m- your suite runs on this machine\033[0m\n'
printf '\n'
printf '   \033[2mManage it in your browser. This shell is for recovery, and rarely needed.\033[0m\n'
printf '   \033[2mDocs\033[0m  \033[36m@@DOCS_ROOT_URL@@\033[0m\n'
printf '\n'
# The update count this replaces was telling the owner something true. Saying
# nothing at all would leave them with Suite Manager's "everything is current",
# which is only true of MOS.
printf '   \033[2mUbuntu %s base - an unofficial image, not affiliated with Canonical.\033[0m\n' "${VERSION_ID:-24.04}"
printf '   \033[2mMy Own Suite updates itself and your apps. It does not patch the OS.\033[0m\n'
printf '\n'
