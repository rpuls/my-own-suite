#!/usr/bin/env bash
# Runs on every boot, very early. Does nothing unless this machine booted from
# removable media, in which case the stick is the installer: it copies itself to
# an internal disk and reboots into it.
set -euo pipefail

# The copy gives the disk the stick's own filesystem UUIDs, so for a moment two
# disks answer to the same /dev/disk/by-uuid name. udev hands that name to the
# newcomer, boot-efi.mount loses the device it is bound to, systemd stops
# local-fs.target, and everything ordered under it stops with it. That killed
# this script 59ms after the copy finished, every time, before it could give the
# disk identifiers of its own. Holding udev's queue keeps the duplicate out of
# /dev until the rewrite below has made the two disks tell themselves apart.
udev_held=no
hold_udev() {
  udevadm control --stop-exec-queue || return 0
  udev_held=yes
}
release_udev() {
  [ "$udev_held" = 'yes' ] || return 0
  udev_held=no
  udevadm control --start-exec-queue 2>/dev/null || true
  udevadm settle 2>/dev/null || true
}

# The stick installs or it stops: every way out that is not a finished install
# leaves its reason on the screen until someone has read it, then restarts.
# Nothing ever runs from the stick.
stop_here() {
  printf '\n  %s\n\n  %s\n  > ' "$1" "${2:-Press Enter to restart.}"
  read -r _ || true
  fsfreeze -u / 2>/dev/null || true
  release_udev
  sync
  reboot -f
}

# A step without a message of its own would otherwise end the script silently.
# Names the step on the screen and in the kernel log, which the journal keeps.
on_error() {
  local status=$1 line=$2 command=$3
  local message="[mos-self-install] failed at line ${line} (exit ${status}): ${command}"
  printf '%s\n' "$message" > /dev/kmsg 2>/dev/null || true
  stop_here "$message" 'Photograph this screen, then press Enter to restart.'
}
trap 'on_error $? $LINENO "$BASH_COMMAND"' ERR

stage() {
  printf '\n  [%s] %s\n\n' "$(date +%H:%M:%S)" "$1"
}

image_id_file=/boot/efi/mos-image.json

root_source="$(findmnt -no SOURCE / || true)"
[ -n "$root_source" ] || exit 0
root_parent="$(lsblk -no PKNAME "$root_source" 2>/dev/null | head -n1 || true)"
[ -n "$root_parent" ] || exit 0
root_disk="/dev/$root_parent"

transport="$(lsblk -dno TRAN "$root_disk" 2>/dev/null | tr -d ' ' || true)"
removable="$(cat "/sys/block/$root_parent/removable" 2>/dev/null || echo 0)"
if [ "$transport" != "usb" ] && [ "$removable" != "1" ]; then
  exit 0
fi

# Everything shown from here on is also appended to a log on the stick's EFI
# partition, which any Windows or Mac PC can read when the stick is plugged in,
# and copied onto the disk at the end. That partition is not the root, so the
# freeze during the copy does not hold it up.
install_log=/boot/efi/mos-install.log
printf '\n=== My Own Suite installer, %s ===\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$install_log" 2>/dev/null || install_log=/dev/null
exec > >(tee -a "$install_log") 2>&1

source_bytes="$(blockdev --getsize64 "$root_disk")"

candidates=()
while read -r name type; do
  [ "$type" = "disk" ] || continue
  [ "$name" != "$root_disk" ] || continue
  candidate_name="$(basename "$name")"
  candidate_transport="$(lsblk -dno TRAN "$name" 2>/dev/null | tr -d ' ' || true)"
  candidate_removable="$(cat "/sys/block/$candidate_name/removable" 2>/dev/null || echo 0)"
  [ "$candidate_transport" != "usb" ] || continue
  [ "$candidate_removable" != "1" ] || continue
  [ "$(blockdev --getsize64 "$name")" -ge "$source_bytes" ] || continue
  candidates+=("$name")
done < <(lsblk -dnpo NAME,TYPE)

printf '\n'
printf '  My Own Suite installer\n'
printf '  ----------------------\n\n'

if [ "${#candidates[@]}" -eq 0 ]; then
  printf '  No internal disk large enough for this image was found.\n'
  printf '  This image needs at least %s GB.\n' "$((source_bytes / 1000000000 + 1))"
  stop_here 'Nothing was installed.' 'Remove the USB stick, then press Enter to restart.'
fi

# NAME/SIZE/MODEL cannot tell the spare disk from the one holding the family
# photos, so a picker that printed only those would trade a safe refusal for a
# confident mistake. This is the line that has to carry that: how many
# partitions, and what the recognisable ones hold.
describe_contents() {
  local disk="$1"
  local rows part_count summary
  rows="$(paste -d '|' \
    <(lsblk -nro TYPE "$disk" 2>/dev/null) \
    <(lsblk -nro FSTYPE "$disk" 2>/dev/null) \
    <(lsblk -nro LABEL "$disk" 2>/dev/null) 2>/dev/null || true)"
  part_count="$(printf '%s\n' "$rows" | awk -F '|' '$1 == "part"' | wc -l | tr -d ' ')"
  if [ "${part_count:-0}" -eq 0 ]; then
    printf 'empty - no partitions'
    return 0
  fi
  # At most three, because the console has no scrollback and the point is a
  # verdict rather than an inventory.
  summary="$(printf '%s\n' "$rows" | awk -F '|' '
    $1 == "part" && $2 != "" {
      named += 1
      if (named <= 3) {
        entry = $2
        if ($3 != "") entry = entry " \"" $3 "\""
        list = list (list == "" ? "" : ", ") entry
      }
    }
    END {
      if (named > 3) list = list ", and " (named - 3) " more"
      print list
    }
  ')"
  if [ "$part_count" -eq 1 ]; then
    printf 'NOT EMPTY - 1 partition'
  else
    printf 'NOT EMPTY - %s partitions' "$part_count"
  fi
  [ -n "$summary" ] && printf ', %s' "$summary"
  return 0
}

if [ "${#candidates[@]}" -eq 1 ]; then
  printf '  This machine has one disk My Own Suite can install onto:\n\n'
else
  printf '  Which disk should My Own Suite be installed onto?\n\n'
fi

# Ordered by kernel device name rather than by size or emptiness, so the numbers
# are the same on the next boot. Someone who reboots to re-read this screen must
# not find that 2 now means a different disk.
option=0
for candidate in "${candidates[@]}"; do
  option=$((option + 1))
  printf '  %d) %s\n' "$option" "$(lsblk -dno NAME,SIZE,MODEL "$candidate" | sed 's/  */ /g')"
  printf '     %s\n\n' "$(describe_contents "$candidate")"
done
decline_option=$((option + 1))
printf "  %d) Don't install\n\n" "$decline_option"

if [ "$decline_option" -eq 2 ]; then
  choice_hint='1 or 2'
else
  choice_hint="$(printf '1 to %d' "$decline_option")"
fi

# The answer is a digit and anything unrecognised asks again, because the
# previous prompt treated every answer that was not exactly `YES` as "do not
# install". One mistyped character then produced a suite running from the stick
# that looked like a finished install, on a machine that would not boot without
# it. Not installing has to be chosen, never arrived at.
while :; do
  printf '  Choose %s, then press Enter.\n' "$choice_hint"
  printf '  > '
  if ! read -r answer; then
    stop_here 'No console input, so nothing was installed.' 'Remove the USB stick, then press Enter to restart.'
  fi
  case "$answer" in
    '')
      printf '\n  Nothing entered.\n\n'
      continue
      ;;
    *[!0-9]*)
      printf '\n  "%s" is not %s.\n\n' "$answer" "$choice_hint"
      continue
      ;;
  esac

  if [ "$answer" -eq "$decline_option" ]; then
    stop_here 'Not installing. Nothing on this machine has changed.' 'Remove the USB stick, then press Enter to restart.'
  fi

  if [ "$answer" -lt 1 ] || [ "$answer" -gt "$decline_option" ]; then
    printf '\n  "%s" is not %s.\n\n' "$answer" "$choice_hint"
    continue
  fi

  target="${candidates[$((answer - 1))]}"
  target_name="$(basename "$target")"
  target_description="$(lsblk -dno NAME,SIZE,MODEL "$target" | sed 's/  */ /g')"
  target_contents="$(describe_contents "$target")"

  printf '\n  Everything on %s will be erased:\n\n' "$target_name"
  printf '      %s\n' "$target_description"
  printf '      %s\n\n' "$target_contents"
  printf '  Type ERASE to confirm, or press Enter to go back.\n'
  printf '  > '
  read -r confirm || confirm=''
  if [ "${confirm,,}" = 'erase' ]; then
    break
  fi
  printf '\n  Not confirmed, nothing has changed.\n\n'
done

stage 'Copying. This takes a few minutes and must not be interrupted.'
# The freeze below holds every write to the root for the length of the copy, and
# systemd reads a service that has not checked in as a hung one: journald's
# watchdog is three minutes, so it was killed and restarted mid-copy and took the
# log of the install with it. The override lives in /run, so it is gone on the
# next boot and is never part of what is copied to the disk.
for watchdog_unit in systemd-journald systemd-timesyncd; do
  mkdir -p "/run/systemd/system/${watchdog_unit}.service.d"
  printf '[Service]\nWatchdogSec=0\n' > "/run/systemd/system/${watchdog_unit}.service.d/mos-install.conf"
done
systemctl daemon-reload || true

# The stick is a live, writable root while it is copied, and remounting a running
# root read-only fails, so the filesystem is frozen instead: writes wait until the
# copy is done, and the copy is one consistent moment rather than a smear.
sync
hold_udev
fsfreeze -f /
trap 'fsfreeze -u / 2>/dev/null || true; release_udev' EXIT
dd if="$root_disk" of="$target" bs=4M conv=fsync status=progress
fsfreeze -u /
trap - EXIT
sync

# Everything after the copy says what failed and waits to be read. The first
# install that skipped its identity clean did so silently, and the only evidence
# was a disk carrying the stick's host keys.
fail_after_copy() {
  printf '\n  The copy is on %s, but this step failed:\n\n      %s\n' "$target_name" "$1"
  stop_here 'That disk may boot, but it is not a finished install.' 'Photograph this screen, then press Enter to restart.'
}

# Nothing here lays the disk out. The vault gate does that on the disk's first
# boot: it fits the copied partition table to the disk, grows the system to its
# cap and gives the rest to the vault. A copy step that grew the system to fill
# the disk would leave the gate, which never shrinks, nowhere to put the vault.
# Retried, because udev may still hold a partition open from probing the disk
# that was just overwritten; three refusals in a row are a fault to read. It does
# not settle udev: the queue is held here on purpose, so settling would wait for
# events that are not being processed. The partition nodes this needs are made by
# the kernel, and the count checked after each call is what proves they arrived.
reread_partitions() {
  local attempt
  for attempt in 1 2 3; do
    if blockdev --rereadpt "$target" 2>/dev/null; then return 0; fi
    [ "$attempt" -lt 3 ] || fail_after_copy "the kernel would not re-read the disk's partition table"
    sleep 2
  done
}
# Asked of the kernel and of the disk itself, never of lsblk: lsblk reads PARTN
# and PARTTYPE out of udev's database, and udev is held here on purpose, so it
# would answer with a blank for every partition that was just created and the
# EFI partition would look as though it had never appeared.
partitions_of() {
  local disk_name part
  disk_name="$(basename "$1")"
  for part in "/sys/class/block/${disk_name}"/*/partition; do
    [ -e "$part" ] || continue
    printf '/dev/%s\n' "$(basename "$(dirname "$part")")"
  done
}
partition_number() { cat "/sys/class/block/$(basename "$1")/partition" 2>/dev/null || true; }

reread_partitions
source_parts="$(partitions_of "$root_disk" | grep -c . || true)"
target_parts="$(partitions_of "$target" | grep -c . || true)"
[ "$source_parts" = "$target_parts" ] || fail_after_copy "the kernel still shows ${target_parts} partitions on the disk; the copy has ${source_parts}"

# The system partition is found by the number the stick's own root has, the EFI
# partition by its type.
root_partn="$(partition_number "$root_source")"
[ -n "$root_partn" ] || fail_after_copy 'could not read which partition the stick boots from'
system_partition=''
esp_partition=''
while read -r part; do
  [ -n "$part" ] || continue
  [ "$(partition_number "$part")" != "$root_partn" ] || system_partition="$part"
  if [ -z "$esp_partition" ] \
    && [ "$(blkid -p -s PART_ENTRY_TYPE -o value "$part" 2>/dev/null || true)" = 'c12a7328-f81f-11d2-ba4b-00a0c93ec93b' ]; then
    esp_partition="$part"
  fi
done < <(partitions_of "$target")
[ -n "$system_partition" ] || fail_after_copy "partition ${root_partn} did not appear on the disk"
[ -n "$esp_partition" ] || fail_after_copy 'no EFI system partition appeared on the disk'

# The copy is the stick byte for byte, identifiers included: the same disk and
# partition GUIDs, the same filesystem UUIDs. The firmware's boot entry, GRUB's
# search and the kernel's root= all find a disk by those, and with the stick
# left in they found the internal disk first — so the stick booted the disk,
# this installer saw a fixed root and stepped aside, and the machine could not
# be reinstalled. The disk gets identifiers of its own here, and every file on
# it that names the old ones is rewritten, because one left behind is a disk
# that boots only while the stick is in. Read with a raw probe: blkid's cache
# still answers the old value after a change.
stage 'Giving the disk its own identity.'
fs_uuid() { blkid -p -s UUID -o value "$1" 2>/dev/null || true; }
old_system_uuid="$(fs_uuid "$system_partition")"
old_esp_uuid="$(fs_uuid "$esp_partition")"
{ [ -n "$old_system_uuid" ] && [ -n "$old_esp_uuid" ]; } || fail_after_copy 'could not read the copied filesystems'
sgdisk -G "$target" >/dev/null 2>&1 || fail_after_copy 'could not give the disk its own partition identifiers'
reread_partitions
# A checked filesystem is what tune2fs requires before it will rewrite the
# checksums a new UUID changes; the copy was frozen, so this finds nothing.
e2fsck -fy "$system_partition" >/dev/null 2>&1 || [ $? -le 1 ] || fail_after_copy 'the copied system partition did not check clean'
tune2fs -U random "$system_partition" >/dev/null 2>&1 || fail_after_copy 'could not give the system partition its own identifier'
fatlabel -i "$esp_partition" "$(od -An -N4 -tx4 /dev/urandom | tr -d ' \n')" >/dev/null 2>&1 || fail_after_copy 'could not give the EFI partition its own identifier'
new_system_uuid="$(fs_uuid "$system_partition")"
new_esp_uuid="$(fs_uuid "$esp_partition")"
{ [ -n "$new_system_uuid" ] && [ "$new_system_uuid" != "$old_system_uuid" ]; } || fail_after_copy 'the system partition kept its identifier'
{ [ -n "$new_esp_uuid" ] && [ "$new_esp_uuid" != "$old_esp_uuid" ]; } || fail_after_copy 'the EFI partition kept its identifier'

# The two disks answer to different names now, so udev may see the new one. The
# mount is checked rather than assumed: if /boot/efi had followed the duplicate
# to the copy, every line logged above was written to the disk being installed
# instead of to the stick the owner takes away.
release_udev
boot_efi_source="$(findmnt -no SOURCE /boot/efi 2>/dev/null || true)"
boot_efi_is_the_stick=no
while read -r part; do
  [ "$part" != "$boot_efi_source" ] || boot_efi_is_the_stick=yes
done < <(partitions_of "$root_disk")
[ -z "$boot_efi_source" ] || [ "$boot_efi_is_the_stick" = 'yes' ] \
  || fail_after_copy "the disk's EFI partition took over /boot/efi from the stick"

# Mounted under /run, a tmpfs, so nothing here depends on the root being writable.
target_root=/run/mos-self-install/target
mkdir -p "$target_root"
mount_error="$(mount "$system_partition" "$target_root" 2>&1)" || fail_after_copy "could not open ${system_partition}: ${mount_error}"
mount_error="$(mount "$esp_partition" "$target_root/boot/efi" 2>&1)" || fail_after_copy "could not open ${esp_partition}: ${mount_error}"

# The stick was running while it was copied, so the copy carries the stick's
# identity: its SSH host keys, its machine-id and its journal so far. Cleared
# here so the disk's first boot makes its own, as a fresh install would, and
# two machines installed from one stick never share a host key or a DHCP id.
rm -f "$target_root"/etc/ssh/ssh_host_*
: > "$target_root/etc/machine-id"
rm -f "$target_root/var/lib/dbus/machine-id"
rm -rf "$target_root"/var/log/journal/*

# fstab mounts both by UUID; GRUB's menu names the root for its search and the
# kernel's root=; the two ESP configs are what BOOTX64.EFI reads first to find
# the root at all. Each is checked afterwards: a rewrite that missed one would
# only show as a disk that will not boot with the stick out.
for named in etc/fstab boot/grub/grub.cfg boot/efi/EFI/ubuntu/grub.cfg boot/efi/EFI/BOOT/grub.cfg; do
  [ -f "$target_root/$named" ] || continue
  sed -i "s/${old_system_uuid}/${new_system_uuid}/gI; s/${old_esp_uuid}/${new_esp_uuid}/gI" "$target_root/$named"
  ! grep -qiE "${old_system_uuid}|${old_esp_uuid}" "$target_root/$named" || fail_after_copy "${named} still names the stick's identifiers"
done
grep -q "$new_system_uuid" "$target_root/etc/fstab" || fail_after_copy 'fstab does not name the system partition'
grep -q "$new_system_uuid" "$target_root/boot/grub/grub.cfg" || fail_after_copy 'the GRUB menu does not name the system partition'
grep -q "$new_system_uuid" "$target_root/boot/efi/EFI/BOOT/grub.cfg" || fail_after_copy 'the EFI loader config does not name the system partition'
cp -f "$install_log" "$target_root/var/log/mos-install.log" 2>/dev/null || true
sync
umount "$target_root/boot/efi"
umount "$target_root"

# The image carries its bootloader at the removable-media fallback path only, so
# a fixed disk boots solely on firmware that tries EFI/BOOT/BOOTX64.EFI unasked.
# The ones that do not say "no bootable drive" with the stick out and boot
# normally with it in, which reads as a failed install rather than a missing
# NVRAM entry. Naming the loader here is what tells that firmware where to look.
register_boot_entry() {
  [ -d /sys/firmware/efi ] || return 1
  command -v efibootmgr >/dev/null 2>&1 || return 1

  local esp_number existing
  esp_number="$(printf '%s' "$esp_partition" | grep -oE '[0-9]+$' || true)"
  [ -n "$esp_number" ] || return 1

  # Installing a second time, or onto a different disk, must not leave the
  # firmware choosing between this entry and one naming a disk that is gone.
  while read -r existing; do
    [ -n "$existing" ] || continue
    efibootmgr --delete-bootnum --bootnum "$existing" >/dev/null 2>&1 || true
  done < <(efibootmgr 2>/dev/null | awk '
    /^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/ {
      num = substr($0, 5, 4)
      rest = substr($0, 9)
      sub(/^\*/, "", rest)
      sub(/^[ \t]+/, "", rest)
      sub(/\t.*$/, "", rest)
      sub(/[ \t]+$/, "", rest)
      if (rest == "My Own Suite") print num
    }')

  # Prepended to BootOrder by efibootmgr, so the installed disk is tried before
  # whatever the firmware was booting before.
  efibootmgr --create --disk "$target" --part "$esp_number" \
    --loader '\EFI\BOOT\BOOTX64.EFI' --label 'My Own Suite' >/dev/null 2>&1 || return 1
}

stage "Registering the disk with this machine's firmware."
if register_boot_entry; then
  boot_entry_registered=1
else
  boot_entry_registered=0
fi

printf '\n'
printf '  Done.\n\n'
if [ "$boot_entry_registered" -eq 0 ]; then
  printf '  This machine'"'"'s firmware would not take a boot entry, so it may still\n'
  printf '  need %s selected as its boot device in the BIOS/UEFI setup screen.\n\n' "$target_name"
fi
# The restart comes first: this script, its shell and the reboot command all live
# on the stick, and the first hardware install pulled it at this prompt and
# watched the screen fill with read errors while Enter did nothing.
printf '  Press Enter to restart. Remove the USB stick as soon as the screen goes\n'
printf '  dark; the machine then starts from its own disk.\n'
printf '  > '
read -r _ || true
sync
reboot -f
