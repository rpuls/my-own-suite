#!/usr/bin/env bash
# Runs on every boot, very early. Does nothing unless this machine booted from
# removable media, in which case the stick is the installer: it copies itself to
# an internal disk and reboots into it.
set -euo pipefail

image_id_file=/boot/efi/mos-image.json

root_source="$(findmnt -no SOURCE / || true)"
[ -n "$root_source" ] || exit 0
root_parent="$(lsblk -no PKNAME "$root_source" 2>/dev/null | head -n1 || true)"
[ -n "$root_parent" ] || exit 0
root_disk="/dev/$root_parent"

transport="$(lsblk -dno TRAN "$root_disk" 2>/dev/null | tr -d ' ' || true)"
removable="$(cat "/sys/block/$root_parent/removable" 2>/dev/null || echo 0)"
if [ "$transport" != "usb" ] && [ "$removable" != "1" ]; then
  exit 0
fi

source_bytes="$(blockdev --getsize64 "$root_disk")"

candidates=()
while read -r name type; do
  [ "$type" = "disk" ] || continue
  [ "$name" != "$root_disk" ] || continue
  candidate_name="$(basename "$name")"
  candidate_transport="$(lsblk -dno TRAN "$name" 2>/dev/null | tr -d ' ' || true)"
  candidate_removable="$(cat "/sys/block/$candidate_name/removable" 2>/dev/null || echo 0)"
  [ "$candidate_transport" != "usb" ] || continue
  [ "$candidate_removable" != "1" ] || continue
  [ "$(blockdev --getsize64 "$name")" -ge "$source_bytes" ] || continue
  candidates+=("$name")
done < <(lsblk -dnpo NAME,TYPE)

printf '\n'
printf '  My Own Suite installer\n'
printf '  ----------------------\n\n'

if [ "${#candidates[@]}" -eq 0 ]; then
  printf '  No internal disk large enough for this image was found.\n'
  printf '  This image needs at least %s GB.\n\n' "$((source_bytes / 1000000000 + 1))"
  printf '  Press Enter to continue booting from the USB stick. Nothing will be\n'
  printf '  installed, and this machine will not boot once the stick is removed.\n'
  read -r _ || true
  exit 0
fi

if [ "${#candidates[@]}" -gt 1 ]; then
  printf '  This machine has more than one internal disk:\n\n'
  lsblk -dno NAME,SIZE,MODEL "${candidates[@]}" | sed 's/^/    /'
  printf '\n  Refusing to guess which one to erase. Disconnect the disks you want\n'
  printf '  to keep, then reboot.\n\n'
  printf '  Press Enter to continue from the USB stick. Nothing will be installed,\n'
  printf '  and this machine will not boot once the stick is removed.\n'
  read -r _ || true
  exit 0
fi

target="${candidates[0]}"
target_name="$(basename "$target")"
target_description="$(lsblk -dno NAME,SIZE,MODEL "$target" | sed 's/  */ /g')"

printf '  This machine has one disk My Own Suite can install onto:\n\n'
printf '      %s\n\n' "$target_description"
printf '  1) Install onto %s  -  ERASES EVERYTHING on that disk\n' "$target_name"
printf "  2) Don't install  -  run from this USB stick (advanced / recovery)\n\n"

# The answer is a digit and anything unrecognised asks again, because the
# previous prompt treated every answer that was not exactly `YES` as "do not
# install". One mistyped character then produced a suite running from the stick
# that looked like a finished install, on a machine that would not boot without
# it. Not installing has to be chosen, never arrived at.
while :; do
  printf '  Choose 1 or 2, then press Enter.\n'
  printf '  > '
  if ! read -r answer; then
    printf '\n  No console input. Continuing to boot from the USB stick.\n\n'
    exit 0
  fi
  case "$answer" in
    2)
      printf '\n  Not installing.\n\n'
      printf '  This machine runs My Own Suite from the USB stick. Nothing is installed\n'
      printf '  on %s, and it will not boot once the stick is removed. Reboot with the\n' "$target_name"
      printf '  stick attached to install.\n\n'
      exit 0
      ;;
    1)
      printf '\n  Everything on this disk will be erased:\n\n'
      printf '      %s\n\n' "$target_description"
      printf '  Type ERASE to confirm, or press Enter to go back.\n'
      printf '  > '
      read -r confirm || confirm=''
      if [ "${confirm,,}" = 'erase' ]; then
        break
      fi
      printf '\n  Not confirmed, nothing has changed.\n\n'
      ;;
    '')
      printf '\n  Nothing entered.\n\n'
      ;;
    *)
      printf '\n  "%s" is not 1 or 2.\n\n' "$answer"
      ;;
  esac
done

printf '\n  Copying. This takes a few minutes and must not be interrupted.\n\n'
sync
mount -o remount,ro / 2>/dev/null || true

dd if="$root_disk" of="$target" bs=4M conv=fsync status=progress
sync

printf '\n  Expanding the system to fill the disk.\n'
partprobe "$target" 2>/dev/null || true
sgdisk -e "$target" >/dev/null 2>&1 || true
partprobe "$target" 2>/dev/null || true

last_partition="$(lsblk -nrpo NAME,TYPE "$target" | awk '$2 == "part" { print $1 }' | tail -n1)"
if [ -n "$last_partition" ]; then
  partition_number="$(printf '%s' "$last_partition" | grep -oE '[0-9]+$' || true)"
  if [ -n "$partition_number" ]; then
    growpart "$target" "$partition_number" >/dev/null 2>&1 || true
    partprobe "$target" 2>/dev/null || true
  fi
  e2fsck -fy "$last_partition" >/dev/null 2>&1 || true
  resize2fs "$last_partition" >/dev/null 2>&1 || true
fi
sync

printf '\n'
printf '  Done.\n\n'
printf '  Remove the USB stick now, then press Enter to restart.\n'
printf '  > '
read -r _ || true
sync
reboot -f
