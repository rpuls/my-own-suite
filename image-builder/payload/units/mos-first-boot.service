[Unit]
Description=Announce this My Own Suite machine's own address and server login
After=network-online.target mos-suite-manager.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/mos-first-boot
# Journal only. This unit waits for the network and for Suite Manager, so it can
# finish long after agetty has painted the banner - and anything it echoes to the
# console lands on top of the screen it exists to produce.
StandardOutput=journal
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
