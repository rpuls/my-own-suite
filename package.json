{
  "name": "my-own-suite",
  "version": "0.1.0",
  "private": true,
  "description": "My Own Suite launch platform workspace.",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "scripts": {
    "apps:catalog": "node scripts/app-package-catalog.cjs",
    "apps:catalog:check": "node scripts/app-package-catalog.cjs --check && node scripts/sign-app-catalog.cjs --check",
    "apps:catalog:sign": "node scripts/sign-app-catalog.cjs",
    "apps:manifest:check": "node scripts/app-manifest-check.cjs",
    "apps:version:check": "node scripts/app-version-guard.cjs",
    "apps:privacy:check": "node scripts/app-privacy-check.cjs",
    "apps:privacy:monitor": "node scripts/app-privacy-monitor.cjs",
    "build": "cd site && npm install --no-audit --progress=false && npm run build",
    "build:client": "npm run branding:sync && vite build --config suite-manager/vite.config.mjs",
    "branding:sync": "node scripts/sync-branding.cjs",
    "dev": "npm run build:client && node suite-manager/backend/src/server/start.cjs",
    "e2e:install": "playwright install chromium",
    "e2e:full": "playwright test --config test/e2e/playwright.hyperv.config.mjs",
    "e2e:full:headed": "playwright test --config test/e2e/playwright.hyperv.config.mjs --headed",
    "e2e:local": "playwright test --config test/e2e/playwright.config.mjs",
    "e2e:local:headed": "playwright test --config test/e2e/playwright.config.mjs --headed",
    "e2e:vaultwarden": "playwright test --config test/e2e/playwright.hyperv-vaultwarden.config.mjs",
    "e2e:vaultwarden:headed": "playwright test --config test/e2e/playwright.hyperv-vaultwarden.config.mjs --headed",
    "hooks:install": "git config core.hooksPath .githooks",
    "install:render": "node scripts/installers/render-bootstrap.cjs",
    "installer:usb": "node scripts/selfhost-build-installer-iso.cjs",
    "nameserver:apply": "node scripts/nameserver.cjs apply",
    "nameserver:destroy": "node scripts/nameserver.cjs destroy",
    "nameserver:plan": "node scripts/nameserver.cjs plan",
    "nameserver:render": "node scripts/nameserver.cjs render",
    "nameserver:ssh-open": "node scripts/nameserver.cjs ssh-open",
    "nameserver:status": "node scripts/nameserver.cjs status",
    "nameserver:verify": "node scripts/nameserver.cjs verify",
    "release:check": "node scripts/release-check.cjs",
    "release:prepare": "node scripts/release-prepare.cjs",
    "screenshots:update": "node scripts/screenshots-update.cjs",
    "smoke:do:destroy": "node scripts/smoke/digitalocean.cjs destroy",
    "smoke:do:dns01": "node scripts/smoke/dns01.cjs",
    "smoke:do:render": "node scripts/smoke/digitalocean.cjs render",
    "smoke:do:reset": "node scripts/smoke/digitalocean.cjs reset",
    "smoke:hyperv:destroy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke/hyperv-usb-lab.ps1 destroy",
    "smoke:hyperv:refresh": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke/hyperv-usb-lab.ps1 refresh",
    "smoke:hyperv:reset": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke/hyperv-usb-lab.ps1 reset",
    "test": "npm run typecheck && npm run test:unit && npm run apps:manifest:check && npm run apps:catalog:check && npm run apps:version:check && npm run apps:privacy:check && npm run apps:privacy:monitor && npm run installer:check && npm run release:check && npm run build:client && npm run build",
    "installer:check": "node -e \"require('fs').mkdirSync('.tmp',{recursive:true})\" && npm run install:render -- --target json > .tmp/installer-contract.json",
    "test:unit": "npm run branding:sync && node --test suite-manager/backend/test/*.test.cjs system-agents/apps/*.test.cjs system-agents/backup/*.test.cjs system-agents/backup/engines/*.test.cjs system-agents/diagnostics/*.test.cjs system-agents/https/*.test.cjs system-agents/lib/*.test.cjs system-agents/homepage/*.test.cjs system-agents/update/*.test.cjs test/unit/*.test.cjs test/unit/*.test.mjs",
    "typecheck": "tsc --project suite-manager/tsconfig.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "22.x",
    "npm": "11.x"
  }
}
