# The MCP server MOS offers an owner's AI for Paperless-ngx. It reuses the pinned
# Paperless image for its Python, so it adds no image of its own to download.
FROM ghcr.io/paperless-ngx/paperless-ngx@sha256:8508853b8a0f8394074260957d0be186c8c64f346973b24a7583de4580f306b9

COPY mcp-server.py /opt/mos/mcp-server.py
RUN chmod 0644 /opt/mos/mcp-server.py
# The Paperless image's own check probes port 8000, which this service does not serve.
HEALTHCHECK --interval=30s --timeout=5s CMD ["python3", "-c", "import socket; socket.create_connection(('127.0.0.1', 8100), 3)"]
USER 1000:1000
ENTRYPOINT ["python3", "/opt/mos/mcp-server.py"]
