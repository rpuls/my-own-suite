---
import LandingLayout from '../layouts/LandingLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import Hero from '../components/Hero.astro'
import ValuePromise from '../components/ValuePromise.astro'
import WhyMosExists from '../components/WhyMosExists.astro'
import HowItWorks from '../components/HowItWorks.astro'
import InstallPaths from '../components/InstallPaths.astro'
import AppCatalog from '../components/AppCatalog.astro'
import ExternalApps from '../components/ExternalApps.astro'
import WhoItsFor from '../components/WhoItsFor.astro'
import Tour from '../components/Tour.astro'
import Safety from '../components/Safety.astro'
import Faq from '../components/Faq.astro'
import OpenSource from '../components/OpenSource.astro'
import FooterCta from '../components/FooterCta.astro'
import SiteFooter from '../components/SiteFooter.astro'
import BetaDisclaimer from '../components/BetaDisclaimer.astro'
---

<LandingLayout>
  <SiteHeader />
  <main>
    <Hero />
    <ValuePromise />
    <HowItWorks />
    <AppCatalog />
    <ExternalApps />
    <WhoItsFor />
    {/* Objection handling ("why this and not CasaOS/Cloudron?") only lands once
        the reader knows what MOS is and has seen the catalog — so it sits after
        WhoItsFor rather than competing with the pitch near the top. */}
    <WhyMosExists />
    <Tour />
    <InstallPaths />
    <Safety />
    <Faq />
    <FooterCta />
    <OpenSource />
  </main>
  <SiteFooter />
  <BetaDisclaimer />
</LandingLayout>
