<section class="band" id="safe">
  <div class="shell">
    <div class="section-head center">
      <span class="mos-eyebrow">Kept safe</span>
      <h2 class="mos-section-title">Backups, updates, and a serious trust architecture</h2>
    </div>
    <div class="paths">
      <div class="mos-panel path">
        <span class="ico" style="width:2.6rem;height:2.6rem;border-radius:var(--mos-radius-sm);display:grid;place-items:center;background:var(--mos-color-accent-soft);color:var(--mos-color-accent)"><svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-shield"/></svg></span>
        <h3 style="font-size:1.15rem">Private HTTPS at home</h3>
        <p class="mos-meta" style="font-size:0.92rem">Real green-lock certificates on your LAN via Cloudflare DNS-01 — without exposing anything to the internet.</p>
      </div>
      <div class="mos-panel path">
        <span class="ico" style="width:2.6rem;height:2.6rem;border-radius:var(--mos-radius-sm);display:grid;place-items:center;background:var(--mos-color-accent-soft);color:var(--mos-color-accent)"><svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-key"/></svg></span>
        <h3 style="font-size:1.15rem">Secrets stay secret</h3>
        <p class="mos-meta" style="font-size:0.92rem">Secrets never enter the database, logs, or API responses. Narrow host agents apply changes; the web UI never gets root.</p>
      </div>
      <div class="mos-panel path">
        <span class="ico" style="width:2.6rem;height:2.6rem;border-radius:var(--mos-radius-sm);display:grid;place-items:center;background:var(--mos-color-accent-soft);color:var(--mos-color-accent)"><svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-check"/></svg></span>
        <h3 style="font-size:1.15rem">One-click managed updates</h3>
        <p class="mos-meta" style="font-size:0.92rem">Current vs latest, a plain change summary, live progress, and stable / lab tracks. Technical logs behind "Advanced details."</p>
      </div>
    </div>
  </div>
</section>
