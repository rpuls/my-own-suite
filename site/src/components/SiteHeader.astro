---
import BrandMark from './BrandMark.astro'
import { DOCS_PATH, GITHUB_REPO_URL } from '../lib/links'
---

<header class="site-header">
  <div class="shell">
    <div class="site-header-inner">
      <span class="brand">
        <BrandMark size={34} />
        <span class="mos-eyebrow" style="font-size:0.82rem">My Own Suite</span>
      </span>
      <nav class="site-nav">
        <a href="#how">How it works</a>
        <a href="#apps">Apps</a>
        <a href="#safe">Safety</a>
        <a href="#install">Install</a>
      </nav>
      <div class="site-header-actions">
        <a href={GITHUB_REPO_URL} rel="noopener"><svg width="18" height="18" aria-hidden="true"><use href="#i-github"/></svg>GitHub</a>
        <a href={DOCS_PATH}>Docs</a>
      </div>
    </div>
  </div>
</header>
