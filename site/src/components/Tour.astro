---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

// The tour screenshots come from the E2E capture pipeline: a human-run
// `npm run e2e:full` captures them, `npm run screenshots:update` copies
// them into ../assets/screenshots/ under stable names (see
// scripts/README.md). An entry renders only when its screenshot exists,
// so a screen that has not been captured yet never breaks the build — it
// appears automatically on the next screenshot refresh.
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', {
  eager: true
})

const tour = [
  {
    file: 'app-catalog',
    title: "No need to know the app's name",
    copy: 'Type what you want to replace, like Dropbox, or what you want to do, like photos, and the catalog finds the open-source app for it. One tap installs it; the database, the address and the padlock are sorted behind the scenes.',
    alt: 'The MOS App Catalog'
  },
  {
    file: 'app-detail-install',
    title: "Know exactly what you're getting",
    copy: 'Every app has a plain-language page: what it does, what it replaces, what it asks of your machine, and how private it is.',
    alt: "An app's detail view with a one-click Install action and its privacy posture grade"
  },
  {
    file: 'privacy-posture',
    title: 'A privacy grade, with receipts',
    copy: 'Every catalog app is assessed before it gets in and wears an A-to-D grade. Tap it to see why, dimension by dimension, backed by published evidence.',
    alt: "The privacy posture dialog showing an app's A-to-D grade and per-dimension verdicts"
  },
  {
    file: 'app-connect',
    title: 'Apps that plug into each other',
    copy: 'Connect Seafile to ONLYOFFICE and every document in your file cloud opens for editing in the browser. One button, and no keys to copy between admin panels.',
    alt: 'Two apps shown as a plug and socket with a one-click Connect action'
  },
  {
    file: 'app-update-review',
    title: 'Updates you approve, not endure',
    copy: 'See what an update changes before it happens, including whether the privacy grade moved. You press the button, and if it fails MOS puts the old version back.',
    alt: 'The update review dialog listing what an app update changes before it is applied'
  },
  {
    file: 'backups',
    title: 'Backups that run themselves',
    copy: 'On a schedule, to a drive you plug in or to storage online, encrypted with a recovery key only you hold. Under the hood is restic, the battle-tested open-source backup engine, so the archive opens anywhere. One button brings the whole suite back.',
    alt: 'Backup and restore page in Suite Manager'
  }
]

const entries = tour.flatMap((entry) => {
  const image = shots[`../assets/screenshots/${entry.file}.png`]?.default
  return image ? [{ ...entry, image }] : []
})

const imageProps = {
  widths: [560, 1120],
  sizes: '(max-width: 900px) 100vw, 560px',
  format: 'webp' as const,
  quality: 82
}
---

<section class="band">
  <div class="shell">
    <div class="section-head">
      <span class="mos-eyebrow">A quick tour</span>
      <h2 class="mos-section-title">As easy as the phone in your pocket</h2>
    </div>
    {entries.map((entry) => (
      <div class="tour-row">
        <div class="tour-copy">
          <h3 class="mos-card-title" style="font-size:1.4rem">{entry.title}</h3>
          <p class="mos-meta" style="margin-top:8px">{entry.copy}</p>
        </div>
        <div class="tour-frame"><Image src={entry.image} alt={entry.alt} {...imageProps} /></div>
      </div>
    ))}
  </div>
</section>
