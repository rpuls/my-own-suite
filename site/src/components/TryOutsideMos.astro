---
// "Just want to try <app>?" — the section the landing catalog's Try button
// links to, rendered on the docs app page for every package that declares a
// catalog.demoDeployTargets entry in its manifest.
//
// The Try button used to point straight at the Railway template, which left
// first-time visitors with no idea what MOS actually is (or why they would
// install it rather than deploy apps one at a time). The button now lands
// here instead: the demo deploy is still one click away, framed against what
// installing inside MOS gives you.
//
// The MOS benefits and the Railway notes are deliberately generic — they read
// the same for every app, so there is nothing per-app to maintain in the
// manifests beyond the deploy URL itself.
import { GET_STARTED_PATH } from '../lib/links'

interface Props {
  appName: string
  railwayUrl: string
  gettingStartedUrl?: string
}

const { appName, railwayUrl, gettingStartedUrl = GET_STARTED_PATH } = Astro.props

const mosBenefits = [
  { title: 'Yours to control', detail: 'runs on your own machine or any VPS you pick — and can move anytime' },
  { title: 'One dashboard', detail: 'every app you run, in one place at your own domain' },
  { title: 'Backups built in', detail: 'back up and restore your apps in a couple of clicks' },
  { title: 'Fully private if you want', detail: 'on your own hardware, apps can stay off the public internet entirely' },
  { title: 'Updates handled', detail: 'version-pinned, health-checked, applied for you' },
  { title: 'HTTPS and domains', detail: 'trusted certificates without touching DNS records' },
  { title: 'Apps that connect', detail: 'file, calendar, and office apps work together' }
]
const railwayPoints = [
  { title: 'Live in minutes', detail: 'deploy from a template, fill in a few setup fields' },
  { title: 'The real thing, not a demo', detail: 'the same app MOS installs, running for you' }
]
const railwayTradeoffs = [
  { title: 'Railway account required', detail: 'a third-party cloud with its own sign-up and usage billing' },
  { title: 'Tied to Railway', detail: 'MOS runs anywhere and can migrate; this deploy lives on their platform' }
]

const CHECK_PATH = 'M4 12.5l5 5L20 6.5'
---

<section class="try-outside" aria-labelledby="try-outside-mos">
  <span class="mos-eyebrow">Try before you commit</span>
  <h2 id="try-outside-mos">Just want to try {appName}?</h2>
  <p class="try-outside-intro">
    MOS is the way to grow a suite — apps installed, backed up, and updated together, all in one
    tailored dashboard. But if you'd rather see {appName} on its own first, we've set up a one-click
    deploy on Railway so you can kick the tires with nothing to install.
  </p>

  {/* not-content opts the cards out of Starlight's markdown flow spacing —
      without it .sl-markdown-content's "* + *" rule adds a top margin to the
      second grid item, pushing the Railway card down out of alignment. */}
  <div class="try-outside-grid not-content">
    <div class="try-card is-mos">
      <div class="try-card-head">
        <h3>Install in MOS</h3>
        <span class="try-pill is-accent">Recommended</span>
      </div>
      <ul class="try-points">
        {mosBenefits.map((benefit) => (
          <li>
            <span class="try-mark is-accent">
              <svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d={CHECK_PATH}></path></svg>
            </span>
            <span><strong>{benefit.title}</strong> — <span class="try-detail">{benefit.detail}</span></span>
          </li>
        ))}
      </ul>
      <div class="try-card-action">
        <a class="mos-btn mos-btn-primary" href={gettingStartedUrl}>Get started with MOS</a>
      </div>
    </div>

    <div class="try-card is-demo">
      <div class="try-card-head">
        <h3>Try it on Railway</h3>
        <span class="try-pill is-warning">Good for testing</span>
      </div>
      <ul class="try-points">
        {railwayPoints.map((point) => (
          <li>
            <span class="try-mark is-info">
              <svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d={CHECK_PATH}></path></svg>
            </span>
            <span><strong>{point.title}</strong> — <span class="try-detail">{point.detail}</span></span>
          </li>
        ))}
        <li>
          <span class="try-mark is-warning">
            <svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 18h6"></path>
              <path d="M10 21h4"></path>
              <path d="M12 3a6 6 0 0 0-4 10.5c.8.7 1 1.6 1 2.5h6c0-.9.2-1.8 1-2.5A6 6 0 0 0 12 3z"></path>
            </svg>
          </span>
          <span><strong>Free trial</strong> — <span class="try-detail">limited free trial for new users</span></span>
        </li>
        {railwayTradeoffs.map((tradeoff) => (
          <li>
            <span class="try-mark is-warning">
              <svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9"></circle>
                <line x1="12" y1="11" x2="12" y2="16.5"></line>
                <line x1="12" y1="7.5" x2="12" y2="7.6"></line>
              </svg>
            </span>
            <span><strong>{tradeoff.title}</strong> — <span class="try-detail">{tradeoff.detail}</span></span>
          </li>
        ))}
      </ul>
      <div class="try-card-action is-stacked">
        <p class="try-disclaimer">
          Good for a test drive, not the destination — this runs on Railway's cloud, not hardware you
          own, and comes without MOS backups, updates, or your own domain.
        </p>
        <a class="try-deploy" href={railwayUrl} rel="noopener noreferrer" target="_blank">
          <img src="https://railway.app/button.svg" alt="Deploy on Railway" loading="lazy" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Spacing is explicit rather than flex-gap: the section's own children stay
     inside Starlight's markdown flow so the h2 matches its sibling headings,
     and these margins override the layered defaults it would otherwise apply. */
  .try-outside {
    margin-top: 1.5em;
  }

  .try-outside .mos-eyebrow {
    display: block;
    margin-bottom: 0.35rem;
  }

  .try-outside h2 {
    margin-top: 0;
  }

  .try-outside-intro {
    margin-top: var(--mos-space-3);
    max-width: 62ch;
    color: var(--mos-color-text-muted);
    line-height: 1.6;
  }

  .try-outside-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    align-items: stretch;
    gap: var(--mos-space-5);
    margin-top: var(--mos-space-6);
  }

  .try-card {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    margin: 0;
    padding: 1.75rem;
    border: 1px solid var(--mos-color-surface-border);
    border-radius: var(--mos-radius-lg);
    background: var(--mos-color-surface-muted);
    box-shadow: var(--mos-shadow-soft);
  }

  /* The recommended path carries the accent border; the demo card stays
     visually quieter so the two read as primary and alternative. */
  .try-card.is-mos {
    border-color: var(--mos-color-accent-border);
    background: var(--mos-color-surface);
  }

  .try-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--mos-space-3);
  }

  .try-card-head h3 {
    margin: 0;
    color: var(--mos-color-text-strong);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .try-pill {
    padding: 4px 12px;
    border: 1px solid;
    border-radius: var(--mos-radius-pill);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .try-pill.is-accent {
    border-color: var(--mos-color-accent-border);
    background: var(--mos-color-accent-soft);
    color: var(--mos-color-accent);
  }

  .try-pill.is-warning {
    border-color: var(--mos-color-warning-border);
    background: var(--mos-color-warning-soft);
    color: var(--mos-color-warning);
  }

  .try-points {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--mos-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .try-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .try-points strong {
    font-weight: 700;
  }

  .try-detail {
    color: var(--mos-color-text-muted);
  }

  .try-mark {
    display: inline-flex;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* The design's bullet hexes are the dark-theme values of these tokens, so
     going through the tokens renders identically and keeps light mode sane. */
  .try-mark.is-accent { color: var(--mos-color-accent); }
  .try-mark.is-info { color: var(--mos-color-info); }
  .try-mark.is-warning { color: var(--mos-color-warning); }

  .try-mark svg {
    width: 18px;
    height: 18px;
  }

  .try-card-action {
    display: flex;
    margin-top: auto;
  }

  .try-card-action.is-stacked {
    flex-direction: column;
    gap: var(--mos-space-4);
  }

  .try-disclaimer {
    margin: 0;
    padding-top: 14px;
    border-top: var(--mos-border-hairline);
    color: var(--mos-color-text-muted);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .try-deploy {
    display: inline-flex;
    align-items: center;
    width: fit-content;
  }

  .try-deploy img {
    display: block;
    height: 40px;
  }
</style>
