---
import BrandMark from './BrandMark.astro'
import { CHANGELOG_URL, DOCS_PATH, GITHUB_REPO_URL, PRIVACY_PATH, TERMS_PATH } from '../lib/links'
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-row">
      <span class="brand"><BrandMark size={26} /> <span class="mos-eyebrow" style="font-size:0.76rem">My Own Suite</span></span>
      <nav class="footer-links">
        <a href={DOCS_PATH}>Docs</a><a href={GITHUB_REPO_URL}>GitHub</a><a href={CHANGELOG_URL}>Changelog</a><a href={TERMS_PATH}>Terms</a><a href={PRIVACY_PATH}>Privacy</a>
      </nav>
      <span>Free &amp; open source · Beta 0.x</span>
    </div>
  </div>
</footer>
