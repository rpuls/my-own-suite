---
// Beta prototype disclaimer — a dismissible snackbar that floats over the
// bottom-left of the landing page, plus an "About this beta" dialog behind
// its "Read more" action. Ported from the Claude Design "Beta Disclaimer"
// mockup; rebuilt on the site's own tokens/classes (mos-badge, mos-btn,
// icon sprite) instead of the design-system React primitives. It stays off
// screen on first load for a clean landing, then slides up from the bottom
// once the visitor starts scrolling. Dismissal persists in localStorage so
// returning visitors are not nagged.
import { MOS_BETA_LABEL } from '../lib/version'
---

<div class="beta-notice" id="beta-notice">
  <div class="beta-notice-body">
    <div class="beta-notice-head">
      <span class="mos-badge mos-pill-accent">{MOS_BETA_LABEL}</span>
      <span class="beta-notice-title">Early software</span>
    </div>
    <p class="beta-notice-text">
      This is a working prototype, not a finished product. Expect some rough edges.
    </p>
    <div>
      <button type="button" class="mos-btn mos-btn-ghost beta-notice-more" data-beta-open>
        Read more
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow-right" /></svg>
      </button>
    </div>
  </div>
  <button type="button" class="beta-notice-dismiss" data-beta-dismiss aria-label="Dismiss">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-x" /></svg>
  </button>
</div>

<div class="beta-dialog-backdrop" data-beta-backdrop hidden></div>
<div
  class="beta-dialog"
  id="beta-dialog"
  role="dialog"
  aria-modal="true"
  aria-labelledby="beta-dialog-title"
  hidden
>
  <button type="button" class="beta-dialog-close" data-beta-close aria-label="Close">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-x" /></svg>
  </button>
  <h2 id="beta-dialog-title" class="beta-dialog-title">About this beta</h2>
  <div class="beta-dialog-content">
    <p>
      My Own Suite is early software. It works — we run it ourselves — but it hasn't yet been
      hardened by years of production use, and some features have had limited real-world testing.
    </p>
    <p>
      We're also open about how it's built: many modules were written partly or mostly with AI
      assistance. Human engineers set the architecture, direct the work, and review the critical
      paths — but not every line has been hand-audited yet.
    </p>
    <p>
      If the project proves its worth and graduates to a real alpha, every module will go through
      full verification by human software engineers before we call it that.
    </p>
    <div class="beta-dialog-callout">
      <span class="beta-dialog-callout-ico"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-shield" /></svg></span>
      <span>
        Practical advice for now: keep backups (MOS makes that easy), and don't make this the only
        copy of anything you'd hate to lose.
      </span>
    </div>
  </div>
  <div class="beta-dialog-footer">
    <button type="button" class="mos-btn mos-btn-primary" data-beta-close>Got it</button>
  </div>
</div>

<script>
  const STORAGE_KEY = 'mos-beta-notice-dismissed'

  const notice = document.getElementById('beta-notice')
  const backdrop = document.querySelector<HTMLElement>('[data-beta-backdrop]')
  const dialog = document.getElementById('beta-dialog')

  if (notice && backdrop && dialog) {
    let dismissed = false
    try {
      dismissed = localStorage.getItem(STORAGE_KEY) === '1'
    } catch {
      /* private mode / storage disabled — treat as not dismissed */
    }

    // Keep the notice off screen on first load. Reveal it (sliding up from the
    // bottom via the .is-visible CSS transition) the first time the visitor
    // scrolls a little way down the page, then stop listening.
    let revealed = false
    const REVEAL_AT = 240
    const reveal = () => {
      if (revealed || dismissed) return
      revealed = true
      notice.classList.add('is-visible')
      window.removeEventListener('scroll', onScroll)
    }
    const onScroll = () => {
      if (window.scrollY > REVEAL_AT) reveal()
    }
    if (!dismissed) {
      window.addEventListener('scroll', onScroll, { passive: true })
      // Handle a page that loads already scrolled (anchor link, refresh).
      onScroll()
    }

    let lastFocused: HTMLElement | null = null

    const openDialog = () => {
      lastFocused = document.activeElement as HTMLElement | null
      backdrop.hidden = false
      dialog.hidden = false
      // next frame so the transition runs from the hidden state
      requestAnimationFrame(() => {
        backdrop.classList.add('open')
        dialog.classList.add('open')
      })
      dialog.querySelector<HTMLElement>('[data-beta-close]')?.focus()
    }

    const closeDialog = () => {
      backdrop.classList.remove('open')
      dialog.classList.remove('open')
      backdrop.hidden = true
      dialog.hidden = true
      lastFocused?.focus()
    }

    const dismissNotice = () => {
      dismissed = true
      notice.classList.remove('is-visible')
      window.removeEventListener('scroll', onScroll)
      try {
        localStorage.setItem(STORAGE_KEY, '1')
      } catch {
        /* ignore */
      }
    }

    notice.querySelector('[data-beta-open]')?.addEventListener('click', openDialog)
    notice.querySelector('[data-beta-dismiss]')?.addEventListener('click', dismissNotice)
    backdrop.addEventListener('click', closeDialog)
    dialog
      .querySelectorAll('[data-beta-close]')
      .forEach((el) => el.addEventListener('click', closeDialog))
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !dialog.hidden) closeDialog()
    })
  }
</script>
