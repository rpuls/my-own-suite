---
// The five steps an app update takes before it is offered, as one strip: the
// publisher, three steps inside MOS, the owner. Each arrow is a list item in
// normal flow that stretches to fill the space between two steps, so it ends
// exactly on the next step or on the MOS box with nothing measured. On a
// phone the strip becomes a column and the arrows turn with it.
import { Image } from 'astro:assets'
import nornAvatar from '../assets/norn.png'
---

<ol class="update-flow" aria-label="How an app update reaches your server, in five steps">
  <li class="update-flow-step">
    <span class="update-flow-lane">Upstream</span>
    <span class="update-flow-ico" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r="1" fill="currentColor" stroke="none"/></svg></span>
    <span class="update-flow-label">The publisher releases a version</span>
  </li>
  <li class="update-flow-arrow" role="presentation" aria-hidden="true"><span class="update-flow-line"></span><svg class="update-flow-head" viewBox="0 0 8 10"><path d="M0 0 8 5 0 10z" fill="currentColor"/></svg></li>
  <li class="update-flow-box">
    <span class="update-flow-mos" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 100 100" fill="none"><g stroke="currentColor" stroke-width="6.5" stroke-linecap="round"><line x1="50" y1="36" x2="50" y2="24"/><line x1="50" y1="64" x2="50" y2="76"/><line x1="36" y1="50" x2="24" y2="50"/><line x1="64" y1="50" x2="76" y2="50"/><line x1="36" y1="36" x2="26" y2="26"/><line x1="64" y1="36" x2="74" y2="26"/><line x1="36" y1="64" x2="26" y2="74"/><line x1="64" y1="64" x2="74" y2="74"/></g><g fill="currentColor"><circle cx="18" cy="18" r="13"/><circle cx="50" cy="16" r="13"/><circle cx="82" cy="18" r="13"/><circle cx="16" cy="50" r="13"/><circle cx="84" cy="50" r="13"/><circle cx="18" cy="82" r="13"/><circle cx="50" cy="84" r="13"/><circle cx="82" cy="82" r="13"/></g><rect x="37" y="37" width="26" height="26" rx="3" fill="none" stroke="currentColor" stroke-width="6.5"/></svg>MOS</span>
    <ol class="update-flow-inner" aria-label="Inside MOS">
      <li class="update-flow-step">
        <span class="update-flow-lane update-flow-lane-mos"><svg width="12" height="12" viewBox="0 0 100 100" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="6.5" stroke-linecap="round"><line x1="50" y1="36" x2="50" y2="24"/><line x1="50" y1="64" x2="50" y2="76"/><line x1="36" y1="50" x2="24" y2="50"/><line x1="64" y1="50" x2="76" y2="50"/><line x1="36" y1="36" x2="26" y2="26"/><line x1="64" y1="36" x2="74" y2="26"/><line x1="36" y1="64" x2="26" y2="74"/><line x1="64" y1="64" x2="74" y2="74"/></g><g fill="currentColor"><circle cx="18" cy="18" r="13"/><circle cx="50" cy="16" r="13"/><circle cx="82" cy="18" r="13"/><circle cx="16" cy="50" r="13"/><circle cx="84" cy="50" r="13"/><circle cx="18" cy="82" r="13"/><circle cx="50" cy="84" r="13"/><circle cx="82" cy="82" r="13"/></g><rect x="37" y="37" width="26" height="26" rx="3" fill="none" stroke="currentColor" stroke-width="6.5"/></svg>MOS</span>
        <span class="update-flow-ico is-norn"><Image src={nornAvatar} alt="Norn" width={52} height={52} /><span class="update-flow-bot" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg></span></span>
        <span class="update-flow-label">Our review agent Norn tests the release</span>
      </li>
      <li class="update-flow-arrow" role="presentation" aria-hidden="true"><span class="update-flow-line"></span><svg class="update-flow-head" viewBox="0 0 8 10"><path d="M0 0 8 5 0 10z" fill="currentColor"/></svg></li>
      <li class="update-flow-step">
        <span class="update-flow-ico" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span>
        <span class="update-flow-label">A human reads its results and signs</span>
      </li>
      <li class="update-flow-arrow" role="presentation" aria-hidden="true"><span class="update-flow-line"></span><svg class="update-flow-head" viewBox="0 0 8 10"><path d="M0 0 8 5 0 10z" fill="currentColor"/></svg></li>
      <li class="update-flow-step">
        <span class="update-flow-ico" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 100 100" fill="none"><g stroke="currentColor" stroke-width="6.5" stroke-linecap="round"><line x1="50" y1="36" x2="50" y2="24"/><line x1="50" y1="64" x2="50" y2="76"/><line x1="36" y1="50" x2="24" y2="50"/><line x1="64" y1="50" x2="76" y2="50"/><line x1="36" y1="36" x2="26" y2="26"/><line x1="64" y1="36" x2="74" y2="26"/><line x1="36" y1="64" x2="26" y2="74"/><line x1="64" y1="64" x2="74" y2="74"/></g><g fill="currentColor"><circle cx="18" cy="18" r="13"/><circle cx="50" cy="16" r="13"/><circle cx="82" cy="18" r="13"/><circle cx="16" cy="50" r="13"/><circle cx="84" cy="50" r="13"/><circle cx="18" cy="82" r="13"/><circle cx="50" cy="84" r="13"/><circle cx="82" cy="82" r="13"/></g><rect x="37" y="37" width="26" height="26" rx="3" fill="none" stroke="currentColor" stroke-width="6.5"/></svg></span>
        <span class="update-flow-label">Promoted to the stable track</span>
      </li>
    </ol>
  </li>
  <li class="update-flow-arrow" role="presentation" aria-hidden="true"><span class="update-flow-line"></span><svg class="update-flow-head" viewBox="0 0 8 10"><path d="M0 0 8 5 0 10z" fill="currentColor"/></svg></li>
  <li class="update-flow-step">
    <span class="update-flow-lane">Your server</span>
    <span class="update-flow-ico" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4.1 12 6"/><path d="m5.1 8-2.9-.8"/><path d="m6 12-1.9 2"/><path d="M7.2 2.2 8 5.1"/><path d="M9.037 9.69a.498.498 0 0 1 .653-.653l11 4.5a.5.5 0 0 1-.074.949l-4.349 1.041a1 1 0 0 0-.74.739l-1.04 4.35a.5.5 0 0 1-.95.074z"/></svg></span>
    <span class="update-flow-label">You review, then press the button</span>
  </li>
</ol>

<style>
  /* A step's column is only as wide as its icon; its label is wider and
     overhangs the column on both sides, which is what the side padding
     on the lists reserves. The arrows take whatever is left. */
  .update-flow {
    --uf-col: 6rem;
    --uf-label: 8.75rem;
    --uf-overhang: calc((var(--uf-label) - var(--uf-col)) / 2);
    --uf-ico: 56px;
    --uf-lane: 1.25rem;
    --uf-gap: 0.625rem;
    --uf-line: var(--mos-color-accent);
    display: flex;
    align-items: flex-start;
    margin: var(--mos-space-4) 0 0;
    padding: 0 var(--uf-overhang);
    list-style: none;
    font-family: var(--mos-font-sans);
  }

  .update-flow-inner {
    display: flex;
    align-items: flex-start;
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0 var(--uf-overhang) 12px;
    list-style: none;
  }

  /* Every step reserves the lane row, so all five icons share one centre line;
     the outer steps add the box's border width to stay level with the inner ones. */
  .update-flow-step {
    display: grid;
    grid-template-areas: 'lane' 'ico' 'label';
    grid-template-rows: var(--uf-lane) auto auto;
    row-gap: var(--uf-gap);
    justify-items: center;
    flex: 0 0 var(--uf-col);
    width: var(--uf-col);
    margin: 0;
    padding: 2px 0 0;
    text-align: center;
  }

  .update-flow-inner > .update-flow-step { padding-top: 0; }

  .update-flow-lane {
    grid-area: lane;
    align-self: center;
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mos-color-text-muted);
  }

  .update-flow-lane-mos { display: none; align-items: center; gap: 4px; color: var(--mos-color-accent); }

  .update-flow-ico {
    grid-area: ico;
    position: relative;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    width: var(--uf-ico);
    height: var(--uf-ico);
    border: 2px solid var(--mos-color-accent);
    border-radius: 50%;
    background: var(--mos-color-surface-strong);
    color: var(--mos-color-accent);
  }

  .update-flow-ico.is-norn { background: #071a2a; }
  .update-flow-ico.is-norn img { display: block; width: calc(var(--uf-ico) - 4px); height: calc(var(--uf-ico) - 4px); border-radius: 50%; object-fit: cover; }

  .update-flow-bot {
    position: absolute;
    right: -6px;
    bottom: -4px;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    width: 24px;
    height: 24px;
    border: 2px solid var(--mos-color-bg);
    border-radius: 50%;
    background: var(--mos-color-accent);
    color: var(--mos-color-bg);
  }

  .update-flow-label {
    grid-area: label;
    width: var(--uf-label);
    font-size: 0.85rem;
    line-height: 1.35;
    font-weight: 600;
    color: var(--mos-color-text-strong);
  }

  /* An arrow fills the space between two steps: a line that grows and a head.
     Its top margin puts it on the icons' centre line. */
  .update-flow-arrow {
    display: flex;
    align-items: center;
    flex: 1 1 0;
    height: 10px;
    margin: calc(2px + var(--uf-lane) + var(--uf-gap) + var(--uf-ico) / 2 - 5px) 1px 0 4px;
    color: var(--uf-line);
  }

  .update-flow-inner > .update-flow-arrow { margin-top: calc(var(--uf-lane) + var(--uf-gap) + var(--uf-ico) / 2 - 5px); }
  .update-flow-box + .update-flow-arrow { margin-left: 1px; }

  .update-flow-line { flex: 1 1 auto; height: 2px; background: currentColor; }
  .update-flow-head { display: block; flex: 0 0 auto; width: 8px; height: 10px; }

  /* Weighted two: the box holds two of the four arrows, so every arrow
     grows by the same amount. */
  .update-flow-box {
    position: relative;
    display: flex;
    flex: 2 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 2px solid var(--mos-color-accent-border);
    border-radius: var(--mos-radius-lg);
    background: var(--mos-color-surface-muted);
  }

  .update-flow-mos {
    position: absolute;
    top: 6px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mos-color-accent);
  }

  @media (max-width: 640px) {
    .update-flow { flex-direction: column; align-items: stretch; padding: 0; }
    .update-flow-inner { flex-direction: column; align-items: stretch; padding: 0; }
    .update-flow-label { width: auto; }

    .update-flow-step {
      grid-template-areas: 'ico lane' 'ico label';
      grid-template-columns: var(--uf-ico) minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: 14px;
      row-gap: 2px;
      justify-items: start;
      align-items: center;
      flex: 0 0 auto;
      width: auto;
      padding: 8px 12px 8px 14px;
      text-align: left;
    }

    .update-flow-inner > .update-flow-step { padding: 8px 12px; }
    .update-flow-lane { align-self: end; }
    .update-flow-label { align-self: start; }
    .update-flow-lane-mos { display: inline-flex; }
    .update-flow-mos { display: none; }

    .update-flow-arrow {
      flex-direction: column;
      flex: 0 0 auto;
      width: var(--uf-ico);
      height: 32px;
      margin: 0 0 0 14px;
    }

    .update-flow-inner > .update-flow-arrow { margin: 0 0 0 12px; }
    .update-flow-box + .update-flow-arrow { margin-left: 14px; }
    .update-flow-line { width: 2px; height: auto; }
    .update-flow-head { transform: rotate(90deg); }
    .update-flow-box { flex: 0 0 auto; flex-direction: column; }
  }
</style>
