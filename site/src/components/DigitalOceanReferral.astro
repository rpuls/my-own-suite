---
// Referral CTA for the cloud install guide, using DigitalOcean's official
// badge (natural size 200x65) cropped to the MOS corner radius — no added
// border, which clashes with the badge's own artwork.
// EU/NL ad-labelling rules require the disclosure to sit directly at the
// monetized link — keep the caption adjacent to the button.
//
// The badge is served from /vendor/ rather than DigitalOcean's CDN on
// purpose: a docs page on a privacy-first site should not hand a third party
// the reader's IP and page just to render a button. Re-download it into
// site/public/vendor/ if DigitalOcean refreshes the artwork.
---

<div class="do-referral not-content">
  <a
    href="https://www.digitalocean.com/?refcode=b9d6f3e5386e"
    rel="noopener noreferrer sponsored"
    target="_blank"
  >
    <img
      src="/vendor/digitalocean-referral-badge.svg"
      alt="Sign up at DigitalOcean through MOS's referral link"
      width="200"
      height="65"
      loading="lazy"
    />
  </a>
  <small>Referral link</small>
</div>

<style>
  .do-referral {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
  }

  .do-referral a {
    display: inline-flex;
    overflow: hidden;
    border-radius: var(--mos-radius-sm);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .do-referral a:hover {
    transform: translateY(-1px);
    box-shadow: var(--mos-shadow-soft);
  }

  .do-referral img {
    display: block;
    width: 200px;
    height: 65px;
  }

  .do-referral small {
    color: var(--mos-color-text-muted);
    font-size: 0.78rem;
  }
</style>
