---
import AppConnect from './AppConnect.astro'
import PrivacyPosture from './PrivacyPosture.astro'
import { catalogApps as apps, shortReplaces } from '../lib/app-catalog'

// The app catalog is generated at build time from each package's
// manifest under apps/<app>/manifest.json — the same single source of
// truth Suite Manager uses (see src/lib/app-catalog.ts, shared with the
// docs app pages). Adding a new app package to the repo adds it here
// automatically on the next site build; nothing in this component
// needs to change.

const seafile = apps.find((app) => app.id === 'seafile')
const onlyoffice = apps.find((app) => app.id === 'onlyoffice')

// Cards and the drawer name the top two; the full list still travels with the
// payload so search matches every product an app replaces.
const appsJson = JSON.stringify(
  apps.map((app) => ({ ...app, replacesShort: shortReplaces(app.replaces) }))
).replace(/</g, '\\u003c')
---

<section class="band" id="apps">
  <div class="shell">
    <div class="section-head center">
      <span class="mos-eyebrow">The app catalog</span>
      <h2 class="mos-section-title">Pick what you actually need</h2>
      {/* Two rules this copy exists to keep. Selection is stated as fit — the
          app MOS chose for a job — never as ranking: a headline implying the
          projects outside the catalog lost a contest is hostile to the open
          source it depends on. And nothing here refers to how long the list
          is, in either direction; defending the count answers a question the
          visitor has not asked. Trust claims are already the page's: privacy
          assessments in ValuePromise, pinning and signing in Safety,
          curation-is-not-a-wall in ExternalApps just below. */}
      <p class="mos-body-lg mos-meta">Established open-source projects, each chosen by MOS for one everyday job and packaged so it runs, connects, and updates without setup. Start with one and add more whenever you're ready.</p>
    </div>
    <label class="apps-search">
      <svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-search"/></svg>
      <input id="appSearch" type="search" placeholder="Search — photos, passwords, files, calendar…" aria-label="Search the app catalog" />
    </label>
    <div class="catalog" id="appGrid"></div>
    <div class="apps-pager" id="appsPager" hidden>
      <button type="button" id="appsPrev" aria-label="Previous apps"><svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-arrow-left"/></svg></button>
      <span class="page-info" id="appsPageInfo"></span>
      <button type="button" id="appsNext" aria-label="More apps"><svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-arrow-right"/></svg></button>
    </div>
    {seafile && onlyoffice && (
      <div class="together">
        <AppConnect source={onlyoffice} target={seafile} />
        <div>
          <h3 class="mos-card-title" style="color:var(--mos-color-text-strong)">Apps that work together</h3>
          <p class="mos-meta" style="margin-top:6px">Install Seafile, install ONLYOFFICE, press <strong style="color:var(--mos-color-text-strong)">Connect</strong> — MOS grants the secret, wires the network, and your documents open in the browser editor. No config files.</p>
        </div>
      </div>
    )}
  </div>
</section>

<div class="app-drawer-backdrop" id="appDrawerBackdrop"></div>
<aside class="app-drawer" id="appDrawer" role="dialog" aria-modal="true" aria-label="App details"></aside>

{/* Server-rendered privacy posture tile + score dialog per app (the same
    PrivacyPosture component the docs app pages use). The drawer script
    moves the open app's tile into the drawer facts grid and relocates its
    dialog to <body> — the drawer's transform would otherwise trap and clip
    the dialog's fixed-position backdrop. */}
<div id="appPrivacyStore" hidden>
  {apps.map((app) => (
    <div data-privacy-home={app.id}>
      <PrivacyPosture advisories={app.advisories} appName={app.name} assessmentUrl="/docs/privacy/how-we-assess/" packageVersion={app.version} privacy={app.privacyReview} reportUrl={app.privacyAssessment ? `/docs/apps/${app.id}/#privacy-assessment` : null} />
    </div>
  ))}
</div>

<script is:inline type="application/json" id="mos-apps-data" set:html={appsJson} />

<script>
  type AppData = {
    id: string
    name: string
    category: string
    summary: string
    description: string
    demoDeployTargets: { provider: string; label: string; url: string }[]
    replaces: string[]
    replacesShort: string
    setup: string
    resources: string
    resourcesDetail: string
    resourceLevel: string
    requirements: { memory: string; memoryPeak: string; cpu: string; cpuPeak: string } | null
    screenshots: { src: string; alt: string; caption: string }[]
    services: { id: string; role: string; exposed: boolean; persistent: boolean; requires: string }[]
    privacy: string
    privacyNotes: string[]
    features: { title: string; body: string }[]
    links: Record<string, string>
    tags: string[]
    icon: string
  }

  // Above the whole catalog, so the pager stays hidden and the grid shows
  // everything at once: paginating a short catalog advertises how short it is.
  // The pager reappears on its own once the catalog outgrows this (see
  // `pager.hidden` below), and search results page the same way.
  const PAGE_SIZE = 8
  const LINK_LABELS: Record<string, string> = {
    website: 'Official website',
    repository: 'Source code',
    docs: 'App documentation'
  }

  const apps: AppData[] = JSON.parse(document.getElementById('mos-apps-data')!.textContent || '[]')

  const grid = document.getElementById('appGrid')!
  const search = document.getElementById('appSearch') as HTMLInputElement
  const pager = document.getElementById('appsPager')!
  const prevBtn = document.getElementById('appsPrev') as HTMLButtonElement
  const nextBtn = document.getElementById('appsNext') as HTMLButtonElement
  const pageInfo = document.getElementById('appsPageInfo')!
  const drawer = document.getElementById('appDrawer')!
  const backdrop = document.getElementById('appDrawerBackdrop')!

  let page = 0
  let lastOpener: HTMLElement | null = null

  // The open app's server-rendered privacy tile (see #appPrivacyStore) is
  // borrowed into the drawer facts grid and returned before the next
  // drawer render wipes it away with innerHTML.
  let placedPrivacyTile: { home: HTMLElement; tile: HTMLElement } | null = null

  function returnPrivacyTile() {
    if (!placedPrivacyTile) return
    placedPrivacyTile.home.prepend(placedPrivacyTile.tile)
    placedPrivacyTile = null
  }

  function placePrivacyTile(appId: string, slot: HTMLElement) {
    const home = document.querySelector<HTMLElement>(`[data-privacy-home="${CSS.escape(appId)}"] [data-privacy-posture]`)
    if (!home) return
    const dialog = home.querySelector<HTMLElement>('[data-dialog]')
    if (dialog) document.body.appendChild(dialog)
    const tile = home.querySelector<HTMLElement>('[data-open]')
    if (!tile) return
    slot.appendChild(tile)
    placedPrivacyTile = { home, tile }
  }

  const esc = (value: string) =>
    value.replace(/[&<>"']/g, (char) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] as string
    )

  const icon = (app: AppData, extra = '') =>
    `<span class="app-ico"${extra}><img src="${esc(app.icon)}" alt="" loading="lazy" /></span>`

  function filtered(): AppData[] {
    const query = search.value.trim().toLowerCase()
    if (!query) return apps
    return apps.filter((app) =>
      [app.name, app.category, app.summary, app.description, ...app.replaces, ...app.tags]
        .join(' ')
        .toLowerCase()
        .includes(query)
    )
  }

  function render() {
    const list = filtered()
    const pages = Math.max(1, Math.ceil(list.length / PAGE_SIZE))
    page = Math.min(page, pages - 1)
    const start = page * PAGE_SIZE
    const visible = list.slice(start, start + PAGE_SIZE)

    if (!visible.length) {
      grid.innerHTML = '<p class="apps-empty">No apps match that search yet — the catalog is growing.</p>'
    } else {
      grid.innerHTML = visible
        .map(
          (app) => `<button type="button" class="mos-panel app" data-id="${esc(app.id)}">
  <div class="app-top">${icon(app)}<span class="app-name-wrap"><h3>${esc(app.name)}</h3><span class="app-sub">${esc(app.category)}</span></span></div>
  <p class="mos-meta app-desc">${esc(app.summary)}</p>
  ${app.replacesShort ? `<span class="replaces">Replaces ${esc(app.replacesShort)}</span>` : ''}
</button>`
        )
        .join('')
    }

    pager.hidden = list.length <= PAGE_SIZE
    prevBtn.disabled = page === 0
    nextBtn.disabled = page >= pages - 1
    pageInfo.textContent = list.length
      ? `${start + 1}–${Math.min(start + PAGE_SIZE, list.length)} of ${list.length}`
      : ''
  }

  // Mirrors the resource meter on the Suite Manager app detail tiles.
  const meter = (level: string) => {
    const filled = level === 'high' ? 3 : level === 'medium' ? 2 : level === 'low' ? 1 : 0
    return `<span class="app-res-meter${level === 'high' ? ' is-high' : ''}" aria-hidden="true">${[1, 2, 3]
      .map((bar) => `<span class="${bar <= filled ? 'is-filled' : ''}"></span>`)
      .join('')}</span>`
  }
  const chevron =
    '<svg aria-hidden="true" width="14" height="14" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>'

  function openDrawer(app: AppData, opener: HTMLElement | null) {
    lastOpener = opener
    returnPrivacyTile()
    const screensTile = app.screenshots.length
      ? `<button type="button" class="app-tile app-screens-tile" id="appDrawerScreens" aria-label="Preview ${app.screenshots.length === 1 ? '1 screen' : `${app.screenshots.length} screens`} of ${esc(app.name)}">
          <img src="${esc(app.screenshots[0].src)}" alt="" loading="lazy" />
          <span class="app-screens-head" aria-hidden="true"><span class="k">Screens</span><span class="app-screens-count">(${app.screenshots.length})</span></span>
        </button>`
      : ''
    const resourcesTile = `<button type="button" class="app-tile app-resources-tile" id="appDrawerResources">
        <span class="k">Resources</span>
        <span class="app-resources-line">${meter(app.resourceLevel)}<strong>${esc(app.resources || 'Resource use varies')}</strong></span>
        <span class="app-tile-meta">${app.requirements ? `${esc(app.requirements.memory)} memory` : app.services.length === 1 ? 'Runs as 1 service' : app.services.length ? `Runs as ${app.services.length} services` : 'Details unavailable'}${chevron}</span>
      </button>`
    const tiles = `<div class="app-drawer-tiles">
        ${screensTile}
        <span id="appDrawerPrivacy" style="display:contents"></span>
        ${resourcesTile}
      </div>`
    const features = app.features.length
      ? `<div class="app-drawer-section"><span class="mos-eyebrow">Best for</span><ul class="app-drawer-features">${app.features
          .map((feature) => `<li><span class="app-feature-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24"><use href="#i-check"/></svg></span><div><strong>${esc(feature.title)}</strong>${feature.body ? `<span class="mos-meta">${esc(feature.body)}</span>` : ''}</div></li>`)
          .join('')}</ul></div>`
      : ''
    const privacy = app.privacy
      ? `<div class="app-drawer-section"><span class="mos-eyebrow">Privacy</span><p class="mos-meta">${esc(app.privacy)}</p>${
          app.privacyNotes.length
            ? `<ul class="mos-meta" style="margin:8px 0 0;padding-left:1.1rem;display:grid;gap:4px;font-size:0.92rem">${app.privacyNotes.map((note) => `<li>${esc(note)}</li>`).join('')}</ul>`
            : ''
        }</div>`
      : ''
    const links = Object.entries(app.links)
      .filter(([, url]) => typeof url === 'string' && /^https?:\/\//.test(url))
      .map(([key, url]) => `<a class="mos-link" href="${esc(url)}" rel="noopener">${esc(LINK_LABELS[key] ?? key)} →</a>`)
      .join('')
    // Deliberately an internal link rather than the deploy URL itself: the
    // docs page section frames the demo deploy against installing in MOS, so
    // a first-time visitor does not leave for a third-party cloud without
    // ever learning what MOS is.
    const tryAction = app.demoDeployTargets.length
      ? `<a class="mos-btn mos-btn-primary" href="/docs/apps/${esc(app.id)}/#try-outside-mos" style="width:100%">Try ${esc(app.name)}</a>`
      : ''

    drawer.innerHTML = `<button type="button" class="app-drawer-close" aria-label="Close" id="appDrawerClose"><svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-x"/></svg></button>
<div class="app-drawer-head">${icon(app)}<div><h3 style="margin:0;font-size:1.5rem;color:var(--mos-color-text-strong)">${esc(app.name)}</h3><span class="app-sub">${esc(app.category)}</span>${app.replacesShort ? `<span class="app-drawer-replaces"><span>Replaces</span><strong>${esc(app.replacesShort)}</strong></span>` : ''}</div></div>
${tryAction ? `<div class="app-drawer-primary-actions">${tryAction}</div>` : ''}
${tiles}
<p class="mos-meta" style="margin:0 0 var(--mos-space-5)">${esc(app.description)}</p>
${features}
${privacy}
${links ? `<div class="app-drawer-section"><span class="mos-eyebrow">Links</span><div class="app-drawer-links">${links}</div></div>` : ''}`

    placePrivacyTile(app.id, document.getElementById('appDrawerPrivacy')!)

    drawer.classList.add('open')
    backdrop.classList.add('open')
    document.body.style.overflow = 'hidden'
    document.getElementById('appDrawerClose')!.addEventListener('click', closeDrawer)
    document.getElementById('appDrawerCta')?.addEventListener('click', closeDrawer)
    document.getElementById('appDrawerScreens')?.addEventListener('click', () => openGallery(app))
    document.getElementById('appDrawerResources')?.addEventListener('click', () => openServices(app))
    ;(document.getElementById('appDrawerClose') as HTMLElement).focus()
  }

  // Drill-down dialogs for the screens gallery and the "What runs on your
  // server" view — the same drill-downs the Suite Manager app detail has.
  // They render into <body> like the relocated privacy dialog (the drawer's
  // transform would trap a fixed-position backdrop).
  let openOverlay: HTMLElement | null = null
  let overlayOpener: HTMLElement | null = null

  function closeOverlay() {
    if (!openOverlay) return
    openOverlay.remove()
    openOverlay = null
    overlayOpener?.focus()
    overlayOpener = null
  }

  function showOverlay(html: string, opener: HTMLElement | null) {
    closeOverlay()
    const wrapper = document.createElement('div')
    wrapper.className = 'app-dialog-backdrop'
    wrapper.innerHTML = html
    document.body.appendChild(wrapper)
    openOverlay = wrapper
    overlayOpener = opener
    wrapper.addEventListener('click', (event) => {
      if (event.target === wrapper) closeOverlay()
    })
    for (const button of wrapper.querySelectorAll<HTMLButtonElement>('[data-close]')) {
      button.addEventListener('click', closeOverlay)
    }
    wrapper.querySelector<HTMLButtonElement>('[data-close]')?.focus()
  }

  function openGallery(app: AppData) {
    let slide = 0
    showOverlay(
      `<section class="app-dialog app-gallery-dialog" role="dialog" aria-modal="true" aria-label="${esc(app.name)} screens">
        <div class="app-dialog-header"><h2>${esc(app.name)} screens</h2><button type="button" class="app-dialog-close" data-close aria-label="Close ${esc(app.name)} screens"><svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-x"/></svg></button></div>
        <figure class="app-gallery">
          <div class="app-gallery-frame"><img id="appGalleryImage" src="${esc(app.screenshots[0].src)}" alt="${esc(app.screenshots[0].alt)}" /></div>
          <div class="app-gallery-nav">
            ${app.screenshots.length > 1 ? '<button type="button" class="app-dialog-close" id="appGalleryPrev" aria-label="Previous screen"><svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-arrow-left"/></svg></button>' : ''}
            <figcaption><strong id="appGalleryCaption"></strong>${
              app.screenshots.length > 1
                ? `<span class="app-gallery-dots">${app.screenshots.map((_, index) => `<button type="button" data-slide="${index}" aria-label="Go to screen ${index + 1}"></button>`).join('')}</span>`
                : ''
            }</figcaption>
            ${app.screenshots.length > 1 ? '<button type="button" class="app-dialog-close" id="appGalleryNext" aria-label="Next screen"><svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-arrow-right"/></svg></button>' : ''}
          </div>
        </figure>
      </section>`,
      document.getElementById('appDrawerScreens')
    )
    const image = document.getElementById('appGalleryImage') as HTMLImageElement
    const caption = document.getElementById('appGalleryCaption')!
    const dots = [...(openOverlay?.querySelectorAll<HTMLButtonElement>('[data-slide]') ?? [])]
    const show = (index: number) => {
      slide = (index + app.screenshots.length) % app.screenshots.length
      const shot = app.screenshots[slide]
      image.src = shot.src
      image.alt = shot.alt
      caption.textContent = shot.caption || shot.alt
      for (const dot of dots) dot.classList.toggle('is-active', Number(dot.dataset.slide) === slide)
    }
    document.getElementById('appGalleryPrev')?.addEventListener('click', () => show(slide - 1))
    document.getElementById('appGalleryNext')?.addEventListener('click', () => show(slide + 1))
    for (const dot of dots) dot.addEventListener('click', () => show(Number(dot.dataset.slide)))
    show(0)
  }

  function openServices(app: AppData) {
    const rows = app.services
      .map(
        (service) => `<div class="app-service${service.exposed ? ' is-exposed' : ''}">
          <span class="app-service-dot" aria-hidden="true"></span>
          <span class="app-service-copy"><span class="app-service-role"><strong>${esc(service.role)}</strong><code>${esc(service.id)}</code></span><span class="mos-meta">${service.persistent ? 'Keeps its data in private app storage.' : 'Holds nothing permanent.'}</span>${service.requires ? `<span class="mos-meta">${esc(service.requires)}</span>` : ''}</span>
          <span class="app-service-tag">${service.exposed ? 'Exposed via HTTPS' : 'Internal only'}</span>
        </div>`
      )
      .join('')
    const exposed = app.services.some((service) => service.exposed)
    showOverlay(
      `<section class="app-dialog app-services-dialog" role="dialog" aria-modal="true" aria-label="What runs on your server">
        <div class="app-dialog-header"><h2>What runs on your server</h2><button type="button" class="app-dialog-close" data-close aria-label="Close"><svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-x"/></svg></button></div>
        <div class="app-resources-line">${meter(app.resourceLevel)}<strong>${esc(app.resources || 'Resource use varies')}</strong></div>
        ${app.resourcesDetail ? `<p class="mos-meta">${esc(app.resourcesDetail)}</p>` : ''}
        ${
          app.requirements
            ? `<dl class="app-requirements">
                <div><dt>Memory</dt><dd><strong>${esc(app.requirements.memory)}</strong><span>${app.requirements.memoryPeak ? `up to ${esc(app.requirements.memoryPeak)} while it works` : 'steady'}</span></dd></div>
                <div><dt>Processor</dt><dd><strong>${esc(app.requirements.cpu)}</strong><span>${app.requirements.cpuPeak ? `up to ${esc(app.requirements.cpuPeak)} while it works` : 'steady'}</span></dd></div>
              </dl>
              <p class="mos-meta">Figures the package declares, not a limit MOS enforces. The steady figure is what this app holds all day and is what to add up when deciding whether another app fits; the peak is headroom that only has to be free while the app is busy.</p>`
            : ''
        }
        ${rows ? `<div class="app-service-list">${rows}</div>` : ''}
        <p class="mos-meta app-services-note">${
          exposed
            ? 'MOS installs, updates, and backs these up together as one app. Only the exposed service is reachable from outside — everything else stays internal to this app.'
            : 'MOS installs, updates, and backs these up together as one app. Nothing is exposed publicly — compatible apps reach it internally once you connect them.'
        }</p>
      </section>`,
      document.getElementById('appDrawerResources')
    )
  }

  function closeDrawer() {
    closeOverlay()
    drawer.classList.remove('open')
    backdrop.classList.remove('open')
    document.body.style.overflow = ''
    if (lastOpener) {
      lastOpener.focus()
      lastOpener = null
    }
  }

  grid.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('.app') as HTMLElement | null
    if (!button) return
    const app = apps.find((candidate) => candidate.id === button.dataset.id)
    if (app) openDrawer(app, button)
  })
  backdrop.addEventListener('click', closeDrawer)
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !drawer.classList.contains('open')) return
    // An open privacy dialog consumes Escape before the drawer does.
    if (document.querySelector('[data-dialog]:not([hidden])')) return
    // A gallery or services drill-down closes first, keeping the drawer open.
    if (openOverlay) {
      closeOverlay()
      return
    }
    closeDrawer()
  })
  search.addEventListener('input', () => {
    page = 0
    render()
  })
  prevBtn.addEventListener('click', () => {
    page = Math.max(0, page - 1)
    render()
  })
  nextBtn.addEventListener('click', () => {
    page = page + 1
    render()
  })

  render()
</script>
