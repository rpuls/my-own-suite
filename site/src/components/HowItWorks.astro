<section class="band" id="how">
  <div class="shell">
    <div class="section-head center">
      <span class="mos-eyebrow">How it works</span>
      <h2 class="mos-section-title">Three steps to your own cloud</h2>
      <p class="mos-body-lg mos-meta" style="max-width:40rem">First time or seasoned self-hoster, it's the same three steps.</p>
    </div>
    <div class="steps">
      <div class="mos-panel step">
        <span class="num">1</span>
        <h3 class="mos-card-title">Set it up once</h3>
        <p class="mos-meta">Pick where MOS lives: a spare computer at home, or a cloud server you rent. A short guided setup does the rest.</p>
      </div>
      <div class="mos-panel step">
        <span class="num">2</span>
        <h3 class="mos-card-title">Create your account</h3>
        <p class="mos-meta">Open your new private cloud in the browser and sign up like any app. Nothing to configure by hand.</p>
      </div>
      <div class="mos-panel step">
        <span class="num">3</span>
        <h3 class="mos-card-title">Pick your apps</h3>
        <p class="mos-meta">Install what you want from the catalog. MOS runs each one, keeps it updated, and backs it all up.</p>
      </div>
    </div>
  </div>
</section>
