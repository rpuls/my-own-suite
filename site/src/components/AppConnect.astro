---
// Visual for two apps connecting: one continuous line drawing of two
// rounded boxes, with a plug cable leaving the source app and a socket
// waiting on the target app it plugs into. The app icons render inside
// the boxes as part of the SVG.
//
// Suite Manager draws the same mark for its app connections
// (suite-manager/frontend/src/components/ui.tsx, AppConnect). The geometry
// below and the React copy must stay identical; the styling is shared for
// real through .mos-connect-visual in branding/styles/mos.css.
interface ConnectApp {
  name: string
  icon: string
}
interface Props {
  source: ConnectApp
  target: ConnectApp
}
const { source, target } = Astro.props
---

<svg class="mos-connect-visual" viewBox="0 0 460 160" fill="none" role="img" aria-label={`${source.name} plugs into ${target.name}`}>
  <g stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round">
    <rect x="12" y="24" width="112" height="112" rx="26" />
    <rect x="336" y="24" width="112" height="112" rx="26" />
    <line x1="124" y1="80" x2="172" y2="80" />
    <path d="M 210 52 L 200 52 A 28 28 0 0 0 200 108 L 210 108 Z" />
    <line x1="210" y1="66" x2="236" y2="66" />
    <line x1="210" y1="94" x2="236" y2="94" />
    <path d="M 252 50 L 260 50 A 30 30 0 0 1 260 110 L 252 110 Z" />
    <line x1="290" y1="80" x2="336" y2="80" />
  </g>
  <image href={source.icon} x="40" y="52" width="56" height="56" />
  <image href={target.icon} x="364" y="52" width="56" height="56" />
</svg>
